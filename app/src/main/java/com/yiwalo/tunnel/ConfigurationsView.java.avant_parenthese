        T.dialogue(new AlertDialog.Builder(contexte)
                .setTitle(T.t(R.string.cfg_sni_titre))
                .setMessage(T.t(R.string.cfg_sni_aide))
                .setView(saisie)
                .setPositiveButton(T.t(R.string.cfg_enregistrer), (d, w) -> {
