    private static String[] lireShadowsocks(String lien) {
        try {
            String reste = lien.substring("ss://".length());
            int d = reste.indexOf('#');
            if (d >= 0) {
                reste = reste.substring(0, d);
            }
            int q = reste.indexOf('?');
            if (q >= 0) {
                reste = reste.substring(0, q);
            }
            while (reste.endsWith("/")) {
                reste = reste.substring(0, reste.length() - 1);
            }
            String info;
            int a = reste.lastIndexOf('@');
            if (a >= 0) {
                String brut = java.net.URLDecoder.decode(reste.substring(0, a).replace("+", "%2B"), "UTF-8");
                info = brut.contains(":") ? brut : decoderSs(brut);
            } else {
                String tout = decoderSs(reste);
                int b = tout.lastIndexOf('@');
                info = b >= 0 ? tout.substring(0, b) : tout;
            }
            int p = info.indexOf(':');
            return p < 0 ? new String[]{info, ""}
                    : new String[]{info.substring(0, p), info.substring(p + 1)};
        } catch (Exception e) {
            return new String[]{"", ""};
        }
    }

    private static String decoderSs(String t) throws java.io.UnsupportedEncodingException {
        String n = t.replace('-', '+').replace('_', '/').replace("=", "");
        while (n.length() % 4 != 0) {
            n += "=";
        }
        return new String(android.util.Base64.decode(n, android.util.Base64.DEFAULT), "UTF-8");
    }

    private void editerShadowsocks(final Context ctx, final Configuration c) {
        String[] mp = lireShadowsocks(c.lienOriginal);
        LinearLayout zone = new LinearLayout(ctx);
        zone.setOrientation(LinearLayout.VERTICAL);
        zone.setPadding(dp(20), dp(8), dp(20), 0);
        final EditText nom = champSs(ctx, "Nom", c.nom);
        final EditText hote = champSs(ctx, "Adresse du serveur", c.serveur);
        final EditText port = champSs(ctx, "Port", String.valueOf(c.port));
        port.setInputType(android.text.InputType.TYPE_CLASS_NUMBER);
        final EditText methode = champSs(ctx, "Méthode (ex. aes-256-gcm)", mp[0]);
        final EditText mdp = champSs(ctx, "Mot de passe", mp[1]);
        zone.addView(nom);
        zone.addView(hote);
        zone.addView(port);
        zone.addView(methode);
        zone.addView(mdp);
        ScrollView defil = new ScrollView(ctx);
        defil.addView(zone);
        T.dialogue(new AlertDialog.Builder(ctx)
                .setTitle(T.t("Modifier Shadowsocks"))
                .setView(defil)
                .setPositiveButton(T.t("Enregistrer"), (d, w) -> {
                    try {
                        String h = hote.getText().toString().trim();
                        String info = methode.getText().toString().trim() + ":"
                                + mdp.getText().toString();
                        String b64 = android.util.Base64.encodeToString(info.getBytes("UTF-8"),
                                android.util.Base64.NO_WRAP | android.util.Base64.NO_PADDING
                                        | android.util.Base64.URL_SAFE);
                        String lien = "ss://" + b64 + "@" + (h.contains(":") ? "[" + h + "]" : h)
                                + ":" + port.getText().toString().trim();
                        String n = nom.getText().toString().trim();
                        if (!n.isEmpty()) {
                            lien += "#" + java.net.URLEncoder.encode(n, "UTF-8").replace("+", "%20");
                        }
                        Configuration a = ImportateurLiens.analyser(lien);
                        Configuration nouvelle = new Configuration(c.id, a.nom, a.type,
                                a.serveur, a.port, lien, c.sniManuel);
                        nouvelle.expireLe = c.expireLe;
                        nouvelle.message = c.message;
                        nouvelle.verrouille = c.verrouille;
                        nouvelle.mobileSeulement = c.mobileSeulement;
                        nouvelle.bloquerRoot = c.bloquerRoot;
                        nouvelle.storeSeulement = c.storeSeulement;
                        nouvelle.appareils = c.appareils;
                        store.remplacer(nouvelle);
                        T.toast(ctx, "Enregistré", Toast.LENGTH_SHORT).show());
                        rafraichir();
                    } catch (com.yiwalo.tunnel.config.ErreurImport e) {
                        T.toast(ctx, e.getMessage(), Toast.LENGTH_LONG).show();
                    } catch (java.io.UnsupportedEncodingException e) {
                        T.toast(ctx, "Enregistrement impossible", Toast.LENGTH_LONG).show();
                    }
                })
                .setNegativeButton(T.t(R.string.cfg_annuler), null)
                .show();
    }

    private EditText champSs(Context ctx, String indice, String valeur) {
        EditText e = new EditText(ctx);
        e.setHint(indice);
        e.setText(valeur);
        e.setSingleLine(true);
        return e;
    }

