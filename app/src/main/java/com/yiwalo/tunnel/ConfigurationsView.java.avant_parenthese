            }
            LinearLayout zone = new LinearLayout(contexte);
            zone.setOrientation(VERTICAL);
            zone.setPadding(dp(20), dp(8), dp(20), 0);
            TextView info = new TextView(contexte);
            info.setText(T.t("Certains serveurs ont un certificat sans nom valide. L'autoriser "
                    + "permet la connexion, mais ne protège plus contre une usurpation du "
                    + "serveur. À utiliser seulement pour un serveur de confiance."));
            info.setTextSize(14f);
            zone.addView(info);
            final android.widget.CheckBox cb = new android.widget.CheckBox(contexte);
            cb.setText(T.t("Autoriser un certificat non vérifié"));
            cb.setChecked(c.certNonVerifie);
            zone.addView(cb);
            lireEmpreinte(contexte, c);
            return true;
        });
        return carte;
    }


    private void lireEmpreinte(final Context ctx, final Configuration c) {
        T.toast(ctx, "Lecture du certificat…", Toast.LENGTH_SHORT).show();
        final android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
        new Thread(() -> {
            String empreinte = null;
            String erreur = null;
            try {
                javax.net.ssl.SSLContext sc = javax.net.ssl.SSLContext.getInstance("TLS");
                sc.init(null, new javax.net.ssl.TrustManager[]{new javax.net.ssl.X509TrustManager() {
                    public void checkClientTrusted(java.security.cert.X509Certificate[] x, String a) { }
                    public void checkServerTrusted(java.security.cert.X509Certificate[] x, String a) { }
                    public java.security.cert.X509Certificate[] getAcceptedIssuers() {
                        return new java.security.cert.X509Certificate[0];
                    }
                }}, null);
                String sni = !c.sniManuel.isEmpty() ? c.sniManuel : c.serveur;
                try (java.net.Socket brut = new java.net.Socket()) {
                    brut.connect(new java.net.InetSocketAddress(c.serveur, c.port), 8000);
                    brut.setSoTimeout(8000);
                    javax.net.ssl.SSLSocket ss = (javax.net.ssl.SSLSocket) sc.getSocketFactory()
                            .createSocket(brut, sni, c.port, true);
                    javax.net.ssl.SSLParameters pr = ss.getSSLParameters();
                    pr.setServerNames(java.util.Collections.singletonList(
                            new javax.net.ssl.SNIHostName(sni)));
                    ss.setSSLParameters(pr);
                    ss.startHandshake();
                    java.security.cert.Certificate[] chaine = ss.getSession().getPeerCertificates();
                    byte[] d = java.security.MessageDigest.getInstance("SHA-256")
                            .digest(chaine[0].getEncoded());
                    StringBuilder sb = new StringBuilder();
                    for (byte b : d) {
                        sb.append(String.format("%02x", b));
                    }
                    empreinte = sb.toString();
                }
            } catch (Exception e) {
                erreur = e.getMessage();
            }
            final String emp = empreinte;
            final String err = erreur;
            h.post(() -> {
                if (emp == null) {
                    T.toast(ctx, "Lecture impossible : " + err, Toast.LENGTH_LONG).show();
                    return;
                }
                StringBuilder lisible = new StringBuilder();
                for (int i = 0; i < emp.length(); i += 2) {
                    lisible.append(emp, i, i + 2).append(i < 62 ? ":" : "");
                }
                new AlertDialog.Builder(ctx)
                        .setTitle(T.t("Faire confiance à ce serveur ?"))
                        .setMessage(T.t("Empreinte du certificat :\n\n" + lisible.toString().toUpperCase()
                                + "\n\nSeul ce certificat sera accepté par la connexion."))
                        .setPositiveButton(T.t("Faire confiance"), (d, w) -> {
                            c.pinCert = emp;
                            c.certNonVerifie = false;
                            store.remplacer(c);
                            rafraichir();
                        })
                        .setNeutralButton(T.t("Retirer"), (d, w) -> {
                            c.pinCert = "";
                            store.remplacer(c);
                            rafraichir();
                        })
                        .setNegativeButton(T.t(R.string.cfg_annuler), null)
                        .show();
            });
        }, "yiwalo-empreinte").start();
    }


