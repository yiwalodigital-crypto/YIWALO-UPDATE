        type.setText(T.t(c.type == TypeConnexion.SLOWDNS ? "slowdns" : c.type == TypeConnexion.SSH ? "ssh" : c.type == TypeConnexion.HYSTERIA2 ? "hysteria2" : c.type == TypeConnexion.TUIC ? "tuic" : "v2ray"));
        type.setTextSize(13f);
        type.setTextColor(contexte.getColor(R.color.texte));
        bas.addView(type);
        droite.addView(bas);
        carte.addView(droite);

        carte.setOnClickListener(v -> {
            String refus = PartageConfig.verifierAcces(contexte, c);
            if (refus != null) {
                new AlertDialog.Builder(contexte).setTitle(T.t(c.nom)).setMessage(T.t(refus))
                        .setPositiveButton(T.t(R.string.cfg_ok), null).show();
