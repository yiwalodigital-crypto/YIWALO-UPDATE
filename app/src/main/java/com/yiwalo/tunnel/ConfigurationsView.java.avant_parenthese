                    rafraichir();
                })
                .setNegativeButton(T.t(R.string.cfg_annuler), null)
                .show());
    }

    private void confirmerSuppression(Configuration c) {
        Context contexte = getContext();
        String etatVpn = SuiviVpn.etat().name();
        if (!"DECONNECTE".equals(etatVpn) && !"ERREUR".equals(etatVpn)) {
            T.toast(contexte, "Déconnecte d'abord", Toast.LENGTH_SHORT).show();
            return;
        }
        new AlertDialog.Builder(contexte)
                .setMessage(T.t(contexte.getString(R.string.cfg_confirmer_supprimer, c.nom)))
                .setPositiveButton(T.t(R.string.cfg_supprimer), (d, w) -> {
                    store.supprimer(c.id);
                    rafraichir();
                })
                .setNegativeButton(T.t(R.string.cfg_annuler), null)
                .show();
    }

    private void importerFichier() {
        Context contexte = getContext();
        SelecteurFichier.ouvrir(contexte, uri -> {
            try (java.io.InputStream in = contexte.getContentResolver().openInputStream(uri);
                 java.io.ByteArrayOutputStream out = new java.io.ByteArrayOutputStream()) {
                byte[] buf = new byte[4096];
                int n;
                while ((n = in.read(buf)) > 0) out.write(buf, 0, n);
                traiterYiwalo(out.toString("UTF-8"));
            } catch (Exception e) {
                T.toast(contexte, "Fichier illisible", Toast.LENGTH_LONG).show();
            }
        });
    }

    private void traiterYiwalo(String texte) {
        if (!PartageConfig.necessiteMotDePasse(texte)) {
            traiterYiwalo(texte, "");
            return;
        }
        Context ctx = getContext();
        EditText mdp = new EditText(ctx);
        mdp.setHint(T.t("Mot de passe"));
        mdp.setInputType(android.text.InputType.TYPE_CLASS_TEXT
                | android.text.InputType.TYPE_TEXT_VARIATION_PASSWORD);
        mdp.setPadding(dp(16), dp(12), dp(16), dp(12));
        T.dialogue(new AlertDialog.Builder(ctx)
                .setTitle(T.t("Configuration protégée"))
                .setView(mdp)
                .setPositiveButton(T.t(R.string.cfg_importer),
                        (d, w) -> traiterYiwalo(texte, mdp.getText().toString()))
                .setNegativeButton(T.t(R.string.cfg_annuler), null)
                .show());
    }

    private void traiterYiwalo(String texte, String mdp) {
        Context contexte = getContext();
        Configuration c;
        try {
            c = PartageConfig.importer(texte, mdp);
        } catch (Exception e) {
            T.toast(contexte, "Code invalide ou mot de passe incorrect", Toast.LENGTH_LONG).show();
            return;
        }
        String suite = c.message.isEmpty() ? "" : "\n\n" + c.message;
        if (PartageConfig.expiree(c)) {
            new AlertDialog.Builder(contexte)
                    .setTitle(T.t("Configuration expirée"))
                    .setMessage(T.t("Expirée le " + PartageConfig.formater(c.expireLe) + suite))
                    .setPositiveButton(T.t(R.string.cfg_ok), null)
                    .show();
            return;
        }
        String refus = PartageConfig.verifierAcces(contexte, c);
        if (refus != null) {
            new AlertDialog.Builder(contexte)
                    .setTitle(T.t(c.nom))
                    .setMessage(T.t(refus + suite))
                    .setPositiveButton(T.t(R.string.cfg_ok), null)
                    .show();
            return;
        }
        boolean ajoute = false;
        boolean renouvele = false;
        Configuration existant = null;
        for (Configuration x : store.lister()) {
            if (x.id.equals(c.id)) {
                existant = x;
                break;
            }
        }
        if (existant == null) {
            store.ajouterCopie(c);
            store.selectionner(c.id);
            ajoute = true;
        } else if (existant.expireLe > 0 && c.expireLe != existant.expireLe) {
            Configuration maj = new Configuration(existant.id, c.nom, c.type,
                    c.serveur, c.port, c.lienOriginal, existant.sniManuel);
            maj.expireLe = c.expireLe;
            maj.message = c.message;
            maj.verrouille = c.verrouille;
            maj.mobileSeulement = c.mobileSeulement;
            maj.bloquerRoot = c.bloquerRoot;
            maj.storeSeulement = c.storeSeulement;
            maj.appareils = c.appareils;
            maj.slowNs = c.slowNs;
            maj.slowCle = c.slowCle;
            maj.slowResolveur = c.slowResolveur;
            maj.sshUser = c.sshUser;
            maj.sshMdp = c.sshMdp;
            maj.pinCert = existant.pinCert;
            store.remplacer(maj);
            store.selectionner(existant.id);
            renouvele = true;
        } else {
            store.selectionner(existant.id);
        }
        rafraichir();
        String info = ajoute ? "Configuration ajoutée"
                : (renouvele ? "Configuration renouvelée" : "Configuration déjà présente");
        if (c.expireLe > 0) info += "\nExpire le " + PartageConfig.formater(c.expireLe);
        new AlertDialog.Builder(contexte)
                .setTitle(T.t(c.nom))
                .setMessage(T.t(info + suite))
                .setPositiveButton(T.t(R.string.cfg_ok), null)
                .show();
    }

    private int dp(int valeur) {
        return Math.round(valeur * getResources().getDisplayMetrics().density);
    }
