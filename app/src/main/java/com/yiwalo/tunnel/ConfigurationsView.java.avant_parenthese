                    || c.type == TypeConnexion.HYSTERIA2 || c.type == TypeConnexion.TUIC
                    || c.type == TypeConnexion.SHADOWSOCKS) {
                T.toast(contexte, "Réglage disponible pour VMess, VLESS et Trojan",
                        Toast.LENGTH_SHORT).show();
