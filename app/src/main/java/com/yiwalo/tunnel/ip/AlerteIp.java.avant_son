package com.yiwalo.tunnel.ip;

import android.app.Activity;
import android.app.Notification;
import android.app.NotificationChannel;
import android.app.NotificationManager;
import android.app.PendingIntent;
import android.content.Context;
import android.content.Intent;
import android.content.pm.PackageManager;
import android.media.AudioManager;
import android.media.Ringtone;
import android.media.RingtoneManager;
import android.net.Uri;
import android.os.Build;
import android.os.Handler;
import android.os.Looper;
import com.yiwalo.tunnel.MainActivity;
import com.yiwalo.tunnel.R;

public final class AlerteIp {
    private static final String CANAL = "ip_trouvee_v2";
    private static final Handler h = new Handler(Looper.getMainLooper());
    private static Ringtone sonnerie;
    private static final Runnable coupure = new Runnable() {
        @Override public void run() { couper(); }
    };

    private AlerteIp() { }

    private static void couper() {
        if (sonnerie != null) {
            try { sonnerie.stop(); } catch (RuntimeException ignore) { }
            sonnerie = null;
        }
    }

    @SuppressWarnings("deprecation")
    public static void declencher(Context c, String ip) {
        Context app = c.getApplicationContext();
        if (Build.VERSION.SDK_INT >= 33 && c instanceof Activity
                && app.checkSelfPermission("android.permission.POST_NOTIFICATIONS")
                != PackageManager.PERMISSION_GRANTED) {
            ((Activity) c).requestPermissions(
                    new String[]{"android.permission.POST_NOTIFICATIONS"}, 4242);
        }
        try {
            NotificationManager nm = app.getSystemService(NotificationManager.class);
            NotificationChannel ch = new NotificationChannel(
                    CANAL, "IP trouvée", NotificationManager.IMPORTANCE_HIGH);
            ch.enableVibration(true);
            ch.setVibrationPattern(new long[]{0, 600, 300, 600, 300, 600});
            ch.setSound(null, null);
            nm.createNotificationChannel(ch);
            PendingIntent pi = PendingIntent.getActivity(app, 0,
                    new Intent(app, MainActivity.class),
                    PendingIntent.FLAG_IMMUTABLE | PendingIntent.FLAG_UPDATE_CURRENT);
            Notification n = new Notification.Builder(app, CANAL)
                    .setSmallIcon(R.drawable.ic_power)
                    .setContentTitle("IP trouvée !")
                    .setContentText(ip + " est dans ta liste.")
                    .setContentIntent(pi)
                    .setAutoCancel(true)
                    .setCategory(Notification.CATEGORY_ALARM)
                    .build();
            nm.notify(7101, n);
        } catch (RuntimeException ignore) {
            // notification refusée
        }
        try {
            couper();
            Uri u = RingtoneManager.getDefaultUri(RingtoneManager.TYPE_ALARM);
            if (u == null) u = RingtoneManager.getDefaultUri(RingtoneManager.TYPE_NOTIFICATION);
            sonnerie = RingtoneManager.getRingtone(app, u);
            if (sonnerie != null) {
                sonnerie.setStreamType(AudioManager.STREAM_ALARM);
                sonnerie.play();
            }
        } catch (RuntimeException ignore) {
            // pas de sonnerie
        }
        h.removeCallbacks(coupure);
        h.postDelayed(coupure, 10000);
    }
}
