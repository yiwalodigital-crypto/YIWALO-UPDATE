    // ---------- Moteur de scan (adapté aux réseaux mobiles et au Wi-Fi)

    /** Réseau réel (Orange, Moov ou Wi-Fi), hors tunnel VPN : le scan mesure le vrai réseau. */
    private android.net.Network reseauPhysique() {
        try {
            android.net.ConnectivityManager cm = (android.net.ConnectivityManager)
                    ctx.getSystemService(Context.CONNECTIVITY_SERVICE);
            if (cm == null) return null;
            android.net.Network actif = cm.getActiveNetwork();
            if (actif != null && !estVpn(cm, actif)) return actif;
            for (android.net.Network n : cm.getAllNetworks()) {
                android.net.NetworkCapabilities nc = cm.getNetworkCapabilities(n);
                if (nc != null
                        && nc.hasCapability(android.net.NetworkCapabilities.NET_CAPABILITY_INTERNET)
                        && !nc.hasTransport(android.net.NetworkCapabilities.TRANSPORT_VPN)) {
                    return n;
                }
            }
        } catch (RuntimeException ignore) {
            // pas d'accès à l'état réseau : on utilise le réseau par défaut
        }
        return null;
    }

    private static boolean estVpn(android.net.ConnectivityManager cm, android.net.Network n) {
        android.net.NetworkCapabilities nc = cm.getNetworkCapabilities(n);
        return nc != null && nc.hasTransport(android.net.NetworkCapabilities.TRANSPORT_VPN);
    }

    private Socket nouvelleSocket() {
        Socket s = new Socket();
        android.net.Network n = reseau;
        if (n != null) {
            try {
                n.bindSocket(s);
            } catch (IOException | RuntimeException ignore) {
                // on garde le réseau par défaut
            }
        }
        return s;
    }

    private void lancerScan(final int g, final String hote, final int[] ports) {
        new Thread(() -> {
            final long t0 = System.nanoTime();
            try {
                reseau = reseauPhysique();
                InetAddress[] toutes = reseau != null ? reseau.getAllByName(hote) : InetAddress.getAllByName(hote);
                InetAddress choix = toutes[0];
                for (InetAddress a : toutes) {
                    if (a instanceof Inet4Address) {
                        choix = a;
                        break;
                    }
                }
                final InetAddress adr = choix;
                if (g != gen) return;
                h.post(() -> {
                    if (g != gen) return;
                    resume.setText("0 port ouvert");
                    progression.setText(hote + " · " + adr.getHostAddress() + " · calibrage…");
                });
                final int delai = calibrer(adr);
                if (g != gen) return;

                final java.util.concurrent.ConcurrentLinkedQueue<Integer> expires =
                        new java.util.concurrent.ConcurrentLinkedQueue<>();
                ExecutorService pool = Executors.newFixedThreadPool(Math.min(FILS, ports.length));
                for (final int p : ports) {
                    pool.execute(() -> {
                        if (g == gen && sonderTcp(adr, p, delai) < 0) expires.add(p);
                        fait.incrementAndGet();
                    });
                }
                pool.shutdown();
                while (!pool.awaitTermination(150, TimeUnit.MILLISECONDS)) {
                    if (g != gen) {
                        pool.shutdownNow();
                        return;
                    }
                    majUi(g, ports.length, hote, adr, 0, false);
                }
                if (g != gen) return;
                final int nbDelais = expires.size();

                List<Integer> reessai = new ArrayList<>();
                for (int p : expires) {
                    if (estUsuel(p)) reessai.add(p);
                }
                if (!reessai.isEmpty()) {
                    h.post(() -> {
                        if (g == gen) progression.setText("Vérification des ports usuels…");
                    });
                    ExecutorService p2 = Executors.newFixedThreadPool(Math.min(60, reessai.size()));
                    final int delai2 = Math.min(4000, delai * 2);
                    for (final int p : reessai) {
                        p2.execute(() -> {
                            if (g == gen) sonderTcp(adr, p, delai2);
                        });
                    }
                    p2.shutdown();
                    p2.awaitTermination(15, TimeUnit.SECONDS);
                }
                if (g != gen) return;

                h.post(() -> {
                    if (g == gen) progression.setText("Mesure précise des ms…");
                });
                affiner(adr, g, delai);
                if (g != gen) return;

                final int nbOuverts = ouverts.get();
                final String diag = "\nOuverts " + nbOuverts + " · refusés " + refuses.get()
                        + " · sans réponse " + nbDelais + " · injoignables " + injoignables.get() + " · autres " + autres.get() + (derniereErreur != null ? "\n" + derniereErreur : "")
                        + " · délai " + delai + " ms"
                        + "\nRéseaux testés : " + (TestConfigsView.RESEAUX_DETECTES.isEmpty() ? "aucun" : TestConfigsView.RESEAUX_DETECTES)
                        + "\nSIM : " + (TestConfigsView.DIAG_SIM.isEmpty() ? "-" : TestConfigsView.DIAG_SIM)
                        + (SuiviVpn.etat() == EtatVpn.CONNECTE
                        ? "\nVPN connecté : le scan passe peut-être par le tunnel." : "");
                final boolean suspect = nbOuverts > ports.length * 6 / 10;
                lignesAffichees = -1;
                majUi(g, ports.length, hote, adr, (System.nanoTime() - t0) / 1e9, true);
                h.post(() -> {
                    if (g != gen) return;
                    progression.setText(progression.getText() + diag);
                    if (suspect) {
                        montrerErreur("Ce réseau accepte presque toutes les connexions "
                                + "(proxy de l'opérateur) : les ports ouverts ne sont pas fiables.");
                    }
                });
            } catch (UnknownHostException e) {
                h.post(() -> {
                    if (g != gen) return;
                    enCours = false;
                    barre.setVisibility(GONE);
                    resume.setText("—");
                    progression.setText(hote);
                    montrerErreur("Hôte introuvable : vérifie le nom ou l'adresse IP.");
                    bouton.setText("Réessayer");
                    bouton.setBackground(Ui.fond(ctx, Ui.BLEU, 12, 0));
                });
            } catch (Exception e) {
                final String m = e.getMessage() != null ? e.getMessage()
                        : e.getClass().getSimpleName();
                h.post(() -> {
                    if (g != gen) return;
                    enCours = false;
                    barre.setVisibility(GONE);
                    montrerErreur(m);
                    bouton.setText("Réessayer");
                    bouton.setBackground(Ui.fond(ctx, Ui.BLEU, 12, 0));
                });
            }
        }, "yiwalo-ports").start();
    }

    /** Délai adapté au réseau : on mesure le temps de réponse de l'hôte sur le port 443. */
    private int calibrer(InetAddress adr) {
        Socket s = nouvelleSocket();
        long t0 = System.nanoTime();
        try {
            s.connect(new InetSocketAddress(adr, 443), 1500);
        } catch (SocketTimeoutException e) {
            return 2200;
        } catch (IOException e) {
            // refusé : le temps de réponse sert quand même
        } finally {
            try {
                s.close();
            } catch (IOException ignore) {
                // fermeture sans importance
            }
        }
        long rtt = (System.nanoTime() - t0) / 1000000L;
        return (int) Math.max(1200, Math.min(3500, rtt * 4 + 500));
    }

    /** 1 = ouvert, 0 = fermé ou refusé, -1 = sans réponse (délai dépassé). */
    private int sonderTcp(InetAddress adr, int port, int delai) {
        long t0 = System.nanoTime();
        Socket s = nouvelleSocket();
        try {
            s.connect(new InetSocketAddress(adr, port), delai);
            double ms = (System.nanoTime() - t0) / 1e6;
            ouverts.incrementAndGet();
            synchronized (ouvertsListe) {
                ouvertsListe.add(new double[]{port, ms});
            }
            return 1;
        } catch (SocketTimeoutException e) {
            return -1;
        } catch (IOException e) {
            String m = e.getMessage() == null ? "" : e.getMessage().toLowerCase(Locale.ROOT);
            if (m.contains("unreachable") || m.contains("no route")) {
                injoignables.incrementAndGet();
            } else if (m.contains("refused")) {
                refuses.incrementAndGet();
            } else {
                autres.incrementAndGet();
                if (derniereErreur == null) derniereErreur = e.toString();
            }
            return 0;
        } finally {
            try {
                s.close();
            } catch (IOException ignore) {
                // fermeture sans importance
            }
        }
    }

    private static boolean estUsuel(int port) {
        if (SERVICES.containsKey(port)) return true;
        for (int p : PORTS_EN_PLUS) {
            if (p == port) return true;
        }
        return false;
    }

    /** Mesure précise : 3 connexions successives par port ouvert, on garde la plus rapide. */
    private void affiner(final InetAddress adr, final int g, final int delai)
            throws InterruptedException {
        final List<double[]> copie;
        synchronized (ouvertsListe) {
            copie = new ArrayList<>(ouvertsListe);
        }
        if (copie.isEmpty()) return;
        ExecutorService pool = Executors.newFixedThreadPool(Math.min(8, copie.size()));
        for (final double[] e : copie) {
            pool.execute(() -> {
                int port = (int) e[0];
                double meilleur = e[1];
                for (int k = 0; k < 3 && g == gen; k++) {
                    Socket s = nouvelleSocket();
                    try {
                        long t1 = System.nanoTime();
                        s.connect(new InetSocketAddress(adr, port), delai);
                        double ms = (System.nanoTime() - t1) / 1e6;
                        if (ms < meilleur) meilleur = ms;
                    } catch (IOException ignore) {
                        // on garde la mesure précédente
                    } finally {
                        try {
                            s.close();
                        } catch (IOException ignore2) {
                            // fermeture sans importance
                        }
                    }
                }
                synchronized (ouvertsListe) {
                    e[1] = meilleur;
                }
            });
        }
        pool.shutdown();
        pool.awaitTermination(10, TimeUnit.SECONDS);
    }

    private void basculer() {
        if (enCours) arreter(); else demarrer();
    }

    private void arreter() {
        gen++;
        enCours = false;
        barre.setVisibility(GONE);
        progression.setText("Test arrêté.");
        bouton.setText("Scanner à nouveau");
        bouton.setBackground(Ui.fond(ctx, Ui.BLEU, 12, 0));
    }

    private void montrerErreur(String m) {
        erreurVue.setText(m);
        erreurVue.setVisibility(VISIBLE);
    }

    private void demarrer() {
        final String hote;
        final int[] ports;
        erreurVue.setVisibility(GONE);
        try {
            hote = nettoyer(champHote.getText().toString());
            ports = portsATester();
        } catch (IllegalArgumentException e) {
            montrerErreur(e.getMessage());
            return;
        }
        try {
            InputMethodManager imm = (InputMethodManager)
                    ctx.getSystemService(Context.INPUT_METHOD_SERVICE);
            if (imm != null) imm.hideSoftInputFromWindow(champHote.getWindowToken(), 0);
        } catch (RuntimeException ignore) {
            // clavier déjà fermé
        }

        final int g = ++gen;
        enCours = true;
        fait.set(0);
        ouverts.set(0);
        injoignables.set(0); refuses.set(0); autres.set(0); derniereErreur = null;
        synchronized (ouvertsListe) {
            ouvertsListe.clear();
        }
        lignesAffichees = -1;
        liste.removeAllViews();
        resume.setText("Résolution…");
        resume.setTextColor(Ui.TEXTE);
        progression.setText(hote);
        barre.setMax(ports.length);
        barre.setProgress(0);
        barre.setVisibility(VISIBLE);
        bouton.setText("Arrêter");
        bouton.setBackground(Ui.fond(ctx, Ui.ROUGE, 12, 0));

        lancerScan(g, hote, ports);
    }

    /** Tente une connexion TCP : ouverte, fermée (refusée) ou filtrée (sans réponse). */
    private void sonder(InetAddress adr, int port) {
        long t0 = System.nanoTime();
        Socket s = nouvelleSocket();
        try {
            s.connect(new InetSocketAddress(adr, port), DELAI_MS);
            double ms = (System.nanoTime() - t0) / 1e6;
            ouverts.incrementAndGet();
            synchronized (ouvertsListe) {
                ouvertsListe.add(new double[]{port, ms});
            }
        } catch (SocketTimeoutException e) {
            // port filtré ou hôte muet : on ne l'affiche pas
        } catch (IOException e) {
            String m = e.getMessage() == null ? "" : e.getMessage().toLowerCase(Locale.ROOT);
            if (m.contains("unreachable") || m.contains("no route")) injoignables.incrementAndGet();
        } finally {
            try {
                s.close();
            } catch (IOException ignore) {
                // fermeture sans importance
            }
        }
    }

    private static int couleurMs(double ms) {
        return ms <= 100 ? Ui.VERT : ms <= 300 ? Ui.ORANGE : Ui.ROUGE;
    }

    private void majUi(final int g, final int total, final String hote, final InetAddress adr,
                       final double duree, final boolean fini) {
        final int f = fait.get();
        final int o = ouverts.get();
        final int inj = injoignables.get();
        final List<double[]> copie;
        synchronized (ouvertsListe) {
            copie = new ArrayList<>(ouvertsListe);
        }
        Collections.sort(copie, (a, b) -> Double.compare(a[0], b[0]));
        h.post(() -> {
            if (g != gen) return;
            barre.setProgress(Math.min(f, total));
            if (fini) {
                resume.setText(o == 0 ? "Aucun port ouvert"
                        : o + (o > 1 ? " ports ouverts" : " port ouvert"));
                resume.setTextColor(o == 0 ? Ui.ROUGE : Ui.VERT);
                progression.setText(hote + " · " + adr.getHostAddress() + " · "
                        + String.format(Locale.getDefault(), "%.1f s", duree));
                barre.setVisibility(GONE);
                bouton.setText("Scanner à nouveau");
                bouton.setBackground(Ui.fond(ctx, Ui.BLEU, 12, 0));
                enCours = false;
                if (o == 0) {
                    montrerErreur(inj >= total / 2
                            ? "Réseau injoignable : vérifie ta connexion Internet."
                            : "Aucune réponse : tous les ports sont fermés ou filtrés par un "
                            + "pare-feu.");
                }
            } else {
                resume.setText(o + (o > 1 ? " ports ouverts" : " port ouvert"));
                resume.setTextColor(o > 0 ? Ui.VERT : Ui.TEXTE);
                progression.setText("Analyse en cours · " + f + " / " + total);
            }
            if (copie.size() != lignesAffichees) {
                lignesAffichees = copie.size();
                afficherOuverts(copie);
            }
        });
    }

    private void afficherOuverts(List<double[]> l) {
        liste.removeAllViews();
        for (int i = 0; i < l.size(); i++) {
            int port = (int) l.get(i)[0];
            double ms = l.get(i)[1];
            LinearLayout ligne = new LinearLayout(ctx);
            ligne.setOrientation(HORIZONTAL);
            ligne.setGravity(Gravity.CENTER_VERTICAL);
            ligne.setPadding(0, Ui.dp(ctx, 10), 0, Ui.dp(ctx, 10));

            TextView p = Ui.texte(ctx, String.valueOf(port), 18f, Ui.VERT, true);
            ligne.addView(p, new LinearLayout.LayoutParams(Ui.dp(ctx, 70),
                    ViewGroup.LayoutParams.WRAP_CONTENT));

            String nom = SERVICES.get(port);
            TextView s = Ui.texte(ctx, nom == null ? "TCP" : nom, 13f, Ui.DISCRET, false);
            ligne.addView(s, new LinearLayout.LayoutParams(0,
                    ViewGroup.LayoutParams.WRAP_CONTENT, 1f));

            TextView t = Ui.texte(ctx, String.format(Locale.getDefault(), "%.0f ms", ms),
                    15f, couleurMs(ms), true);
            ligne.addView(t);

            if (i > 0) liste.addView(Ui.separateur(ctx));
            liste.addView(ligne);
        }
    }

    @Override protected void onDetachedFromWindow() {
        gen++;
        super.onDetachedFromWindow();
    }
}
