    private static String nettoyer(String s) {
        s = s == null ? "" : s.trim();
        s = s.replaceFirst("^[a-zA-Z][a-zA-Z0-9+.-]*://", "");
        int slash = s.indexOf('/');
        if (slash >= 0) s = s.substring(0, slash);
        int deux = s.indexOf(':');
        if (deux >= 0 && deux == s.lastIndexOf(':')) s = s.substring(0, deux);
        if (s.isEmpty()) throw new IllegalArgumentException("Indique un hôte ou une adresse IP.");
        return s;
    }

    /** Ports 1-1024 et les ports usuels des services, des proxys et des tunnels. */
    private static int[] portsATester() {
        TreeSet<Integer> set = new TreeSet<>();
        for (int p = 1; p <= 1024; p++) set.add(p);
        for (int p : PORTS_EN_PLUS) set.add(p);
        int[] r = new int[set.size()];
        int i = 0;
        for (int p : set) r[i++] = p;
        return r;
    }

