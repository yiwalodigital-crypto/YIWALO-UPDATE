package com.yiwalo.tunnel;

import android.content.ClipData;
import android.content.ClipboardManager;
import android.content.Context;
import android.content.Intent;
import android.content.pm.PackageInfo;
import android.net.Uri;
import android.view.ViewGroup;
import android.widget.LinearLayout;
import android.widget.ScrollView;
import android.widget.TextView;
import android.widget.Toast;

public class PlusView extends ScrollView {

    private static final String LIEN_GROUPE =
            "https://chat.whatsapp.com/FDANZLCOZhxIfSlF4HQhtN?s=cl&p=a&mlu=4&ilr=4";
    private static final String LIEN_NUMERO = "https://wa.me/22652839161";

    public PlusView(final Context ctx) {
        super(ctx);
        // La reconnexion automatique est toujours active dans l'application.
        ctx.getSharedPreferences("yiwalo_reglages", Context.MODE_PRIVATE)
                .edit().remove("reconnexion_auto").apply();

        LinearLayout racine = new LinearLayout(ctx);
        racine.setOrientation(LinearLayout.VERTICAL);
        racine.setPadding(dp(20), dp(24), dp(20), dp(24));
        addView(racine, new ViewGroup.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));

        racine.addView(titre(ctx, "À propos"));
        String version = "?";
        try {
            PackageInfo pi = ctx.getPackageManager().getPackageInfo(ctx.getPackageName(), 0);
            version = pi.versionName;
        } catch (Exception ignore) {
            // version inconnue
        }
        racine.addView(ligne(ctx, "Application : YIWALO TUNNEL"));
        racine.addView(ligne(ctx, "Version : " + version));
        racine.addView(ligne(ctx, "Moteurs : Xray (VMess, VLESS, Trojan), DNSTT + SSH (Slow DNS)"));
        racine.addView(ligne(ctx, "Reconnexion automatique : activée"));

        racine.addView(titre(ctx, "Mon appareil"));
        String id;
        try {
            id = PartageConfig.idAppareil(ctx);
        } catch (RuntimeException e) {
            id = "indisponible";
        }
        final String idFinal = id;
        TextView idVue = ligne(ctx, "ID : " + idFinal);
        idVue.setTextSize(16f);
        idVue.setTextColor(ctx.getColor(R.color.bleu_clair));
        idVue.setOnClickListener(v -> {
            ClipboardManager cm = (ClipboardManager) ctx.getSystemService(Context.CLIPBOARD_SERVICE);
            cm.setPrimaryClip(ClipData.newPlainText("ID appareil", idFinal));
            Toast.makeText(ctx, "ID copié", Toast.LENGTH_SHORT).show();
        });
        racine.addView(idVue);
        racine.addView(discret(ctx, "Touchez l’ID pour le copier."));

        racine.addView(titre(ctx, "Contact"));
        racine.addView(lien(ctx, "Rejoindre le groupe WhatsApp", LIEN_GROUPE));
        racine.addView(lien(ctx, "WhatsApp : +226 52 83 91 61", LIEN_NUMERO));
    }

    private int dp(int v) {
        return Math.round(v * getResources().getDisplayMetrics().density);
    }

    private TextView titre(Context ctx, String t) {
        TextView v = new TextView(ctx);
        v.setText(t);
        v.setTextSize(20f);
        v.setTypeface(v.getTypeface(), android.graphics.Typeface.BOLD);
        v.setTextColor(ctx.getColor(R.color.bleu_clair));
        v.setPadding(0, dp(22), 0, dp(8));
        return v;
    }

    private TextView ligne(Context ctx, String t) {
        TextView v = new TextView(ctx);
        v.setText(t);
        v.setTextSize(15f);
        v.setTextColor(ctx.getColor(R.color.texte));
        v.setPadding(0, dp(6), 0, dp(6));
        return v;
    }

    private TextView discret(Context ctx, String t) {
        TextView v = ligne(ctx, t);
        v.setTextSize(13f);
        v.setTextColor(ctx.getColor(R.color.texte_discret));
        return v;
    }

    private TextView lien(final Context ctx, String texte, final String url) {
        TextView v = ligne(ctx, texte);
        v.setTextSize(16f);
        v.setTextColor(0xFF4ADE80);
        v.setPadding(0, dp(10), 0, dp(10));
        v.setOnClickListener(x -> {
            try {
                ctx.startActivity(new Intent(Intent.ACTION_VIEW, Uri.parse(url)));
            } catch (RuntimeException e) {
                Toast.makeText(ctx, "Impossible d’ouvrir le lien", Toast.LENGTH_SHORT).show();
            }
        });
        return v;
    }
}
