public class YiwaloVpnService extends VpnService {

    public static final String ACTION_CONNECTER = "com.yiwalo.tunnel.action.CONNECTER";
    public static final String ACTION_DECONNECTER = "com.yiwalo.tunnel.action.DECONNECTER";

    private static final String CANAL = "yiwalo_vpn";
    private static final int ID_PRINCIPALE = 1;
    private static final int ID_INFO = 2;
    private static final Pattern IPV4 = Pattern.compile("^\\d{1,3}(\\.\\d{1,3}){3}$");

    private static final class ErreurVpn extends Exception {
        ErreurVpn(String message) {
            super(message);
        }
    }

    private final Object verrou = new Object();
    private Thread fil;
    private volatile boolean arret;
    private ParcelFileDescriptor tun;
    private Process processus;
    private LocalSocket ecoute;
    private LocalServerSocket serveur;
    private File fichierConfig;
    private File fichierSocket;

    @Override
    public void onCreate() {
        super.onCreate();
        NotificationChannel canal = new NotificationChannel(
                CANAL, getString(R.string.canal_nom), NotificationManager.IMPORTANCE_LOW);
        getSystemService(NotificationManager.class).createNotificationChannel(canal);
    }

    @Override
    public int onStartCommand(Intent intent, int flags, int startId) {
        String action = intent == null ? null : intent.getAction();
        if (ACTION_DECONNECTER.equals(action)) {
            Journal.info("Déconnexion demandée.");
            memoriserVoulu(false);
            deconnecter();
        } else if (ACTION_CONNECTER.equals(action)) {
            memoriserVoulu(true);
            demarrer();
        } else if (intent == null) {
            if (voulu()) {
                Journal.info("Service relancé par Android : reconnexion automatique.");
                demarrer();
            } else {
                stopSelf();
            }
        }
        return START_STICKY;
    }

    private void memoriserVoulu(boolean v) {
        getSharedPreferences("yiwalo_reglages", MODE_PRIVATE)
                .edit().putBoolean("tunnel_voulu", v).apply();
    }

    private boolean voulu() {
        return getSharedPreferences("yiwalo_reglages", MODE_PRIVATE)
                .getBoolean("tunnel_voulu", false);
    }

    @Override
    public void onRevoke() {
        memoriserVoulu(false);
        Journal.avertissement("Android a révoqué l'autorisation VPN.");
        deconnecter();
        super.onRevoke();
    }

    @Override
    public void onDestroy() {
        arret = true;
        nettoyer();
        libererVerrouCpu();
        super.onDestroy();
    }

    // ------------------------------------------------------------------
    // Démarrage et arrêt
    // ------------------------------------------------------------------

    private void demarrer() {
        try {
            startForeground(ID_PRINCIPALE, notification(R.string.notif_connexion, true));
        } catch (RuntimeException e) {
            String raison = "Impossible de démarrer le service de premier plan : " + e;
            Journal.erreur(raison);
            SuiviVpn.changer(EtatVpn.ERREUR, raison);
            stopSelf();
            return;
        }
        synchronized (verrou) {
            if (fil != null) {
                Journal.avertissement("Une connexion est déjà en cours : demande ignorée.");
                return;
            }
            arret = false;
            fil = new Thread(this::connexion, "yiwalo-connexion");
            fil.start();
        }
    }

    /** Applique le choix « tunnel par application » ; renvoie true si seules les applications
     *  autorisées passent par le tunnel (l'exclusion de cette application est alors implicite). */
    private boolean appliquerTunnelApps(Builder b) {
        try {
            android.content.SharedPreferences p =
                    getSharedPreferences("yiwalo_tunnel_apps", MODE_PRIVATE);
            String mode = p.getString("mode", "aucun");
            java.util.Set<String> apps = p.getStringSet("apps", null);
            if ("aucun".equals(mode) || apps == null || apps.isEmpty()) {
                return false;
            }
            boolean inclure = "inclure".equals(mode);
            int ok = 0;
            for (String a : apps) {
                if (a == null || a.equals(getPackageName())) continue;
                try {
                    if (inclure) {
                        b.addAllowedApplication(a);
                    } else {
                        b.addDisallowedApplication(a);
                    }
                    ok++;
                } catch (android.content.pm.PackageManager.NameNotFoundException e) {
                    // application désinstallée : ignorée
                }
            }
            if (ok == 0) return false;
            Journal.info("Tunnel par application : " + ok
                    + (inclure ? " application(s) dans le tunnel."
                    : " application(s) hors du tunnel."));
            return inclure;
        } catch (RuntimeException e) {
            Journal.avertissement("Tunnel par application ignoré : " + e.getMessage());
            return false;
        }
    }

    private void deconnecter() {
        arret = true;
        aEteConnecte = false;
        essaisReconnexion = 0;
        new Thread(() -> {
            Thread t;
            synchronized (verrou) {
                t = fil;
            }
            if (t != null) {
                t.interrupt();
            }
            nettoyer();
            etat(EtatVpn.DECONNECTE, "");
            notifierInfo(R.string.notif_deconnecte, "");
            arretService();
        }, "yiwalo-arret").start();
    }

    @SuppressWarnings("deprecation")
    private void arretService() {
        stopForeground(true);
        stopSelf();
    }

    private volatile String indice = "";

    private static String conseilPour(String ligne) {
        if (ligne.contains("REALITY: received real certificate")
                || ligne.contains("REALITY: processed invalid connection")) {
            return "Le serveur ne semble pas reconnaître cette configuration Reality. "
                    + "Vérifiez la clé publique, le Short ID et le SNI, "
                    + "ou demandez un nouveau lien (il est peut-être expiré).";
        }
        if (ligne.contains("x509: certificate is valid for")) {
            return "Le certificat du serveur ne correspond pas au nom TLS. "
                    + "Corrigez le champ SNI avec le nom valide indiqué par votre fournisseur.";
        }
        if (ligne.contains("handshake failure")) {
            return "Le serveur a refusé la connexion sécurisée. "
                    + "Vérifiez le SNI et le type de sécurité, ou demandez un nouveau lien.";
        }
        if (ligne.contains("vless without TLS")) {
            return "Cette configuration n'est pas chiffrée et utilise une adresse IP : "
                    + "le moteur la refuse. Demandez à votre fournisseur un lien avec "
                    + "un nom de domaine ou avec TLS / Reality.";
        }
        if (ligne.contains("i/o timeout")) {
            return "Le serveur ne répond pas dans le délai prévu. "
                    + "Vérifiez le port et votre connexion internet.";
        }
        if (ligne.contains("connection refused")) {
            return "Le serveur refuse la connexion. Vérifiez l'adresse et le port.";
        }
        return null;
    }

    private final java.util.LinkedList<String> diagnostic = new java.util.LinkedList<>();

    private void garderDiagnostic(String corps) {
        synchronized (diagnostic) {
            diagnostic.remove(corps);
            diagnostic.addLast(corps);
            while (diagnostic.size() > 8) {
                diagnostic.removeFirst();
            }
        }
    }


    private static volatile boolean aEteConnecte = false;
    private static volatile int essaisReconnexion = 0;

    private void planifierReconnexion() {
        if (arret || !aEteConnecte) {
            return;
        }
        if (!getSharedPreferences("yiwalo_reglages", MODE_PRIVATE)
                .getBoolean("reconnexion_auto", true)) {
            return;
        }
        final int[] delais = {3, 8, 20, 30, 45, 60, 60, 60};
        if (essaisReconnexion >= delais.length) {
            Journal.avertissement("Reconnexion automatique abandonnée après "
                    + delais.length + " essais.");
            aEteConnecte = false;
            essaisReconnexion = 0;
            return;
        }
        final int d = delais[essaisReconnexion++];
        Journal.info("Reconnexion automatique dans " + d + " s (essai "
                + essaisReconnexion + "/" + delais.length + ").");
        final android.content.Context app = getApplicationContext();
        new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(() -> {
            if (!aEteConnecte) {
                return;
            }
            try {
                app.startForegroundService(new Intent(app, YiwaloVpnService.class)
                        .setAction(ACTION_CONNECTER));
            } catch (RuntimeException e) {
                Journal.avertissement("Reconnexion automatique impossible : " + e.getMessage());
            }
        }, d * 1000L);
    }

    private void echec(String raisonBrute) {
        String raison = indice.isEmpty()
                ? raisonBrute : raisonBrute + " Conseil : " + indice;
        synchronized (diagnostic) {
            for (String l : diagnostic) {
                Journal.avertissement("[moteur] " + l);
            }
            diagnostic.clear();
        }
        Journal.erreur(raison);
        nettoyer();
        etat(EtatVpn.ERREUR, raison);
        notifierInfo(R.string.notif_erreur, raison);
        arretService();
        planifierReconnexion();
    }

    // ------------------------------------------------------------------
    // Séquence de connexion
    // ------------------------------------------------------------------

    private volatile boolean definitif = false;
    private volatile boolean reseauChange = false;
    private volatile boolean reconnexionRapide = false;
    private volatile long debutConnecte = 0;
    private static final java.util.Set<String> CONFIGS_VALIDEES =
            java.util.Collections.newSetFromMap(new java.util.concurrent.ConcurrentHashMap<String, Boolean>());
    private static volatile String muxExclu = "";
    private static volatile String idCourant = "";
    private volatile boolean muxUtilise = false;
    private static final int NB_VARIANTES = 4;
    private static final java.util.concurrent.ConcurrentHashMap<String, Integer> VARIANTES =
            new java.util.concurrent.ConcurrentHashMap<>();
    private static final java.util.Set<String> ADAPTATION_FINIE =
            java.util.Collections.newSetFromMap(new java.util.concurrent.ConcurrentHashMap<String, Boolean>());
    private volatile int nbAvertissementsMoteur = 0;
    private static final java.util.concurrent.ConcurrentHashMap<String, String> CACHE_IP =
            new java.util.concurrent.ConcurrentHashMap<>();

    private boolean connexionUnique() {
        definitif = false;
        muxUtilise = false;
        nbAvertissementsMoteur = 0;
        try {
            synchronized (diagnostic) {
                diagnostic.clear();
            }
            indice = "";
            etat(EtatVpn.PREPARATION, "Vérification de la configuration");
            Configuration c = new ConfigStore(this).active();
            if (c == null) {
                definitif = true;
                throw new ErreurVpn("Aucune configuration sélectionnée.");
            }
        expireLeActif = c.expireLe;
        String refusAcces = PartageConfig.verifierAcces(this, c);
        if (refusAcces != null) {
            definitif = true;
            throw new ErreurVpn(refusAcces);
        }
        if (c.type == TypeConnexion.SSH) {
            demarrerSsh(c);
        }
        if (c.type == TypeConnexion.SLOWDNS) {
            demarrerSlowDns(c);
        }
            String sniLien = "";
            String hoteLien = "";
            try {
                EditeurLien.Champs champs = EditeurLien.lire(c);
                sniLien = champs.sni;
                hoteLien = champs.hostEntete;
            } catch (ErreurImport ignore) {
                // type non modifiable : pas de terme supplémentaire à masquer
            }
            Journal.definirTermes(c.serveur, c.sniManuel, sniLien, hoteLien);
            Journal.info("Configuration : " + c.nom + " (" + c.type.libelle + ")");

            final String cleConfig = c.id + "|" + c.lienOriginal + "|" + c.sniManuel + "|" + c.pinCert;
            final boolean dejaValide = CONFIGS_VALIDEES.contains(cleConfig);
            String adresse = resoudre(c.serveur);
            long disponibilite = joindre(adresse, c.port);
            if (disponibilite < 0) {
                Journal.avertissement("Test préliminaire du port sans réponse : "
                        + "la connexion continue, le moteur donnera le résultat réel.");
            } else {
                Journal.info("Port du serveur joignable (" + disponibilite + " ms).");
            }
            GenerateurXray.Resultat r;
            idCourant = String.valueOf(c.id);
            GenerateurXray.muxActif = false;
            Integer varMemo = VARIANTES.get(idCourant);
            int variante = varMemo == null ? 0 : varMemo;
            GenerateurXray.variante = variante;
            try {
                r = GenerateurXray.generer(c, adresse);
                if (variante == 2 && !GenerateurXray.fpApplique) {
                    // pas de TLS : l'empreinte ne change rien, on passe au réglage suivant
                    variante = 3;
                    VARIANTES.put(idCourant, 3);
                    GenerateurXray.variante = 3;
                    r = GenerateurXray.generer(c, adresse);
                }
                if (variante > 0) {
                    Journal.info("Réglage réseau adapté au serveur : " + variante + "/"
                            + (NB_VARIANTES - 1));
                }
                muxUtilise = r.json.contains("\"mux\"");
            } catch (ErreurImport e) {
                throw new ErreurVpn(e.getMessage());
            }
            if (!dejaValide) {
                r = epinglageAuto(c, adresse, r);
            }

            String dossier = getApplicationInfo().nativeLibraryDir;
            File xray = new File(dossier, "libxray.so");
            File lanceur = new File(dossier, "libfdexec.so");
            if (!xray.exists() || !lanceur.exists()) {
                definitif = true;
                throw new ErreurVpn("Les moteurs sont absents de l'application.");
            }

            try {
                org.json.JSONObject ss = new org.json.JSONObject(r.json)
                        .getJSONArray("outbounds").getJSONObject(0)
                        .getJSONObject("streamSettings");
                Journal.info("Transport : " + ss.optString("network")
                        + ", sécurité : " + ss.optString("security")
                        + ", nom TLS : " + (ss.optJSONObject("tlsSettings") == null
                        ? "—" : ss.optJSONObject("tlsSettings").optString("serverName", "—")));
            } catch (org.json.JSONException ignore) {
                // résumé facultatif
            }
            fichierConfig = new File(getFilesDir(), "xray-config.json");
            // DIAG-ADRESSE
            try {
                org.json.JSONObject ob = new org.json.JSONObject(r.json)
                        .getJSONArray("outbounds").getJSONObject(0);
                org.json.JSONObject st = ob.optJSONObject("streamSettings");
                org.json.JSONObject se = ob.optJSONObject("settings");
                String ad = "?";
                if (se != null && se.optJSONArray("vnext") != null) {
                    ad = se.getJSONArray("vnext").getJSONObject(0).optString("address", "?");
                } else if (se != null && se.optJSONArray("servers") != null) {
                    ad = se.getJSONArray("servers").getJSONObject(0).optString("address", "?");
                }
                Journal.info("DIAG adresse envoyée au moteur : "
                        + (IPV4.matcher(ad).matches() ? "IP (" + ad + ")" : "nom de domaine")
                        + " | sécurité : " + (st == null ? "-" : st.optString("security", "-"))
                        + " | épinglage : " + (st != null && st.optJSONObject("tlsSettings") != null
                        && st.getJSONObject("tlsSettings").has("pinnedPeerCertSha256") ? "oui" : "non"));
            } catch (org.json.JSONException ignore) {
                // diagnostic facultatif
            }
            ecrire(fichierConfig, r.json);

            if (!dejaValide) {
                Journal.info("Contrôle de la configuration par le moteur.");
                int code = executer(Arrays.asList(
                        xray.getPath(), "run", "-test", "-c", fichierConfig.getPath()), 20);
                if (code != 0) {
                    throw new ErreurVpn("Le moteur refuse la configuration (code " + code
                            + "). Consultez les journaux.");
                }
                CONFIGS_VALIDEES.add(cleConfig);
            }
            verifierArret();

            if (tun == null) {
                etat(EtatVpn.CONNEXION, "Création de l'interface VPN");
                Builder b = new Builder();
                b.setSession(getString(R.string.app_name));
                b.setMtu(1400);
                b.addAddress("172.19.0.1", 30);
                b.addRoute("0.0.0.0", 0);
                b.addDnsServer("1.1.1.1");
                b.addDnsServer("8.8.8.8");
                try {
                    if (!appliquerTunnelApps(b)) {
                        b.addDisallowedApplication(getPackageName());
                    }
                } catch (PackageManager.NameNotFoundException e) {
                    throw new ErreurVpn("Exclusion de l'application impossible.");
                }
                synchronized (verrou) {
                    verifierArret();
                    tun = b.establish();
                }
                if (tun == null) {
                    definitif = true;
                    throw new ErreurVpn("Android a refusé de créer l'interface VPN "
                            + "(autorisation absente ou révoquée).");
                }
                Journal.info("Interface VPN créée.");
            } else {
                Journal.info("Interface VPN conservée : les applications ne voient aucune coupure.");
            }

            fichierSocket = new File(getCacheDir(), "fd.sock");
            fichierSocket.delete();
            ecoute = new LocalSocket(LocalSocket.SOCKET_STREAM);
            ecoute.bind(new LocalSocketAddress(
                    fichierSocket.getPath(), LocalSocketAddress.Namespace.FILESYSTEM));
            serveur = new LocalServerSocket(ecoute.getFileDescriptor());

            etat(EtatVpn.CONNEXION, "Démarrage du moteur");
            ProcessBuilder pb = new ProcessBuilder(Arrays.asList(
                    lanceur.getPath(), fichierSocket.getPath(), "XRAY_TUN_FD",
                    xray.getPath(), "run", "-c", fichierConfig.getPath()));
            pb.environment().put("XRAY_LOCATION_ASSET", getFilesDir().getPath());
            pb.redirectErrorStream(true);
            final Process p = pb.start();
            processus = p;
            lireSortie(p);
            Journal.info("Moteur lancé, transmission de l'interface VPN.");
            envoyerTun();

            etat(EtatVpn.CONNEXION, "Vérification du tunnel");
            long latence = -1;
            for (int i = 0; i < 2 && latence < 0; i++) {
                verifierArret();
                if (!p.isAlive()) {
                    throw new ErreurVpn("Le moteur s'est arrêté pendant le démarrage (code "
                            + p.exitValue() + "). Consultez les journaux.");
                }
                Thread.sleep(i == 0 ? 400 : 1000);
                latence = tester(r, SONDES[i % SONDES.length], 15000);
            }
            if (latence >= 0) {
                ADAPTATION_FINIE.add(idCourant);
            } else if (!ADAPTATION_FINIE.contains(idCourant)) {
                reconnexionRapide = true;
                if (variante < NB_VARIANTES - 1) {
                    VARIANTES.put(idCourant, variante + 1);
                    throw new ErreurVpn("Le serveur ne répond pas avec le réglage " + variante
                            + " : essai d'un autre réglage réseau.");
                }
                VARIANTES.put(idCourant, 0);
                ADAPTATION_FINIE.add(idCourant);
                throw new ErreurVpn("Aucun réglage n'a donné de réponse rapide : "
                        + "retour au réglage par défaut.");
            }
            if (latence < 0) {
                Journal.info("Latence non mesurée : connexion maintenue, la mesure sera retentée.");
            }

            int uid = android.os.Process.myUid();
            SuiviVpn.definirBase(TrafficStats.getUidRxBytes(uid), TrafficStats.getUidTxBytes(uid));
            SuiviVpn.definirLatence(latence);
            Journal.definirLatence(latence);
            indice = "";
            etat(EtatVpn.CONNECTE, "");
            aEteConnecte = true;
            essaisReconnexion = 0;
            debutConnecte = SystemClock.elapsedRealtime();
            getSystemService(NotificationManager.class)
                    .notify(ID_PRINCIPALE, notification(R.string.notif_connecte, true));
            Journal.info("Connexion établie");
            Journal.info("Connecté");
            if (latence >= 0) {
                Journal.info("Ping HTTP 200 OK (" + latence + " ms)");
            }

            surveiller(p, r);
            return false;
        } catch (InterruptedException e) {
            // Arrêt demandé par l'utilisateur : le nettoyage est fait par deconnecter().
            return false;
        } catch (ErreurVpn | IOException | RuntimeException e) {
            if (arret) {
                return false;
            }
            String raison = e.getMessage() == null ? e.toString() : e.getMessage();
            if (muxUtilise && !definitif && !idCourant.isEmpty()) {
                muxExclu = idCourant;
                Journal.info("Mux désactivé pour cette configuration après un échec : "
                        + "nouvel essai sans mux.");
            }
            if (definitif) {
                aEteConnecte = false;
                essaisReconnexion = 0;
                echec(raison);
                return false;
            }
            reessayer(raison);
            return true;
        }
    }

    /** Relance la connexion tant que l'utilisateur ne demande pas la deconnexion. */
    private void connexion() {
        int essai = 0;
        prendreVerrouCpu();
        try {
            while (!arret) {
                boolean relancer = connexionUnique();
                if (!relancer || arret) {
                    break;
                }
                if (debutConnecte > 0
                        && SystemClock.elapsedRealtime() - debutConnecte > 60000L) {
                    essai = 0;
                }
                debutConnecte = 0;
                essai++;
                long pause = reconnexionRapide ? 500L : Math.min(800L + essai * 1200L, 8000L);
                reconnexionRapide = false;
                Thread.sleep(pause);
            }
        } catch (InterruptedException e) {
            // Arrêt demandé par l'utilisateur
        } finally {
            libererVerrouCpu();
            synchronized (verrou) {
                if (fil == Thread.currentThread()) {
                    fil = null;
                }
            }
        }
    }

    private android.os.PowerManager.WakeLock verrouCpu;
    private android.net.wifi.WifiManager.WifiLock verrouWifi;

    private void prendreVerrouCpu() {
        try {
            if (verrouCpu == null) {
                android.os.PowerManager pm = (android.os.PowerManager) getSystemService(POWER_SERVICE);
                verrouCpu = pm.newWakeLock(android.os.PowerManager.PARTIAL_WAKE_LOCK, "yiwalo:tunnel");
                verrouCpu.setReferenceCounted(false);
            }
            if (!verrouCpu.isHeld()) {
                verrouCpu.acquire();
            }
        } catch (RuntimeException ignore) {
            // verrou indisponible : la connexion continue sans lui
        }
        try {
            if (verrouWifi == null) {
                android.net.wifi.WifiManager wm = (android.net.wifi.WifiManager)
                        getApplicationContext().getSystemService(WIFI_SERVICE);
                if (wm != null) {
                    verrouWifi = wm.createWifiLock(
                            android.os.Build.VERSION.SDK_INT >= 29
                                    ? android.net.wifi.WifiManager.WIFI_MODE_FULL_LOW_LATENCY
                                    : android.net.wifi.WifiManager.WIFI_MODE_FULL_HIGH_PERF,
                            "yiwalo:wifi");
                    verrouWifi.setReferenceCounted(false);
                }
            }
            if (verrouWifi != null && !verrouWifi.isHeld()) {
                verrouWifi.acquire();
            }
        } catch (RuntimeException ignore) {
            // verrou Wi-Fi indisponible : sans conséquence
        }
    }

    private void libererVerrouCpu() {
        try {
            if (verrouCpu != null && verrouCpu.isHeld()) {
                verrouCpu.release();
            }
        } catch (RuntimeException ignore) {
            // deja libere
        }
        try {
            if (verrouWifi != null && verrouWifi.isHeld()) {
                verrouWifi.release();
            }
        } catch (RuntimeException ignore) {
            // deja libere
        }
    }

    private void reessayer(String raison) {
        synchronized (diagnostic) {
            for (String l : diagnostic) {
                Journal.avertissement("[moteur] " + l);
            }
            diagnostic.clear();
        }
        Journal.avertissement("Tentative interrompue : " + raison
                + (indice.isEmpty() ? "" : " Conseil : " + indice) + " Nouvelle tentative…");
        nettoyer(aEteConnecte);
        etat(EtatVpn.CONNEXION, "Nouvelle tentative de connexion…");
    }

    private volatile long expireLeActif = 0;

    private static final int SEUIL_ECHECS = 5;
    /** Un tunnel n'est coupé que s'il reste sans réponse au moins ce délai. */
    private static final long DELAI_MIN_ECHEC_MS = 35000L;
    private static final String[] SONDES = {"connectivitycheck.gstatic.com", "cp.cloudflare.com"};

    private android.net.ConnectivityManager.NetworkCallback rappelReseau;
    private volatile android.net.Network reseauActuel;
    private volatile boolean reseauPerdu;

    private void surveillerReseau() {
        try {
            final android.net.ConnectivityManager cm =
                    getSystemService(android.net.ConnectivityManager.class);
            if (cm == null) {
                return;
            }
            reseauActuel = null;
            reseauPerdu = false;
            rappelReseau = new android.net.ConnectivityManager.NetworkCallback() {
                @Override
                public void onAvailable(android.net.Network n) {
                    android.net.Network avant = reseauActuel;
                    reseauActuel = n;
                    if (reseauPerdu || (avant != null && !avant.equals(n))) {
                        reseauChange = true;
                    }
                    reseauPerdu = false;
                }

                @Override
                public void onLost(android.net.Network n) {
                    if (n.equals(reseauActuel)) {
                        reseauActuel = null;
                        reseauPerdu = true;
                    }
                }
            };
            cm.registerDefaultNetworkCallback(rappelReseau);
        } catch (RuntimeException e) {
            rappelReseau = null;
            Journal.avertissement("Surveillance du réseau indisponible : " + e.getMessage());
        }
    }

    private void arreterSurveillanceReseau() {
        try {
            android.net.ConnectivityManager cm =
                    getSystemService(android.net.ConnectivityManager.class);
            if (cm != null && rappelReseau != null) {
                cm.unregisterNetworkCallback(rappelReseau);
            }
        } catch (RuntimeException ignore) {
            // déjà retiré
        }
        rappelReseau = null;
    }

    private void surveiller(Process p, GenerateurXray.Resultat r)
            throws InterruptedException, ErreurVpn {
        final int uid = android.os.Process.myUid();
        int echecs = 0;
        long dernierOk = SystemClock.elapsedRealtime();
        boolean congestionSignalee = false;
        int sondesDegradees = 0;
        long dernierProbleme = 0;
        reseauChange = false;
        surveillerReseau();
        long prochain = SystemClock.elapsedRealtime() + 5000;
        try {
            while (!arret) {
                if (expireLeActif > 0 && System.currentTimeMillis() >= expireLeActif) {
                    aEteConnecte = false;
                    essaisReconnexion = 0;
                    definitif = true;
                    throw new ErreurVpn("Configuration expirée le "
                            + PartageConfig.formater(expireLeActif) + ". Connexion coupée.");
                }
                if (p.waitFor(1, TimeUnit.SECONDS)) {
                    if (arret) {
                        return;
                    }
                    int sortie = p.exitValue();
                    throw new ErreurVpn("Le moteur s'est arrêté de façon inattendue (code "
                            + sortie + (sortie == 137 || sortie == 9
                            ? ") : processus tué par Android (économie d'énergie)."
                            : ")."));
                }
                if (reseauChange) {
                    reseauChange = false;
                    Journal.info("Changement de réseau détecté : vérification du tunnel.");
                    Thread.sleep(2500);
                    boolean vivant = false;
                    // après un changement de réseau, les premières connexions sont lentes :
                    // plusieurs essais avant de décider de relancer
                    for (int i = 0; i < 4 && !vivant && !arret; i++) {
                        if (i > 0) {
                            Thread.sleep(3000);
                        }
                        vivant = tester(r, SONDES[i % SONDES.length]) >= 0;
                    }
                    if (vivant) {
                        Journal.info("Tunnel toujours actif : connexion conservée.");
                        echecs = 0;
                        dernierOk = SystemClock.elapsedRealtime();
                        prochain = SystemClock.elapsedRealtime() + 10000;
                        continue;
                    }
                    reconnexionRapide = true;
                    throw new ErreurVpn("Changement de réseau détecté : reconnexion du tunnel.");
                }
                if (SystemClock.elapsedRealtime() < prochain) {
                    continue;
                }
                long rxAvant = TrafficStats.getUidRxBytes(uid);
                long l = tester(r, SONDES[echecs % SONDES.length]);
                long maintenant = SystemClock.elapsedRealtime();
                if (l >= 0) {
                    if (echecs > 0) {
                        if (false) Journal.info("Tunnel rétabli.");
                    }
                    echecs = 0;
                    dernierOk = maintenant;
                    congestionSignalee = false;
                    SuiviVpn.definirLatence(l);
                    Journal.definirLatence(l);
                    if (l <= 3000) Journal.info("Ping HTTP 200 OK (" + l + " ms)");
                    if (l > 3000) {
                        sondesDegradees++;
                    dernierProbleme = maintenant;
                        Journal.avertissement("Tunnel très lent : sonde à " + l + " ms ("
                                + sondesDegradees + "/3).");
                        if (sondesDegradees >= 3) {
                            reconnexionRapide = true;
                            throw new ErreurVpn("Le tunnel est dégradé (sondes très lentes). "
                                    + "Relance automatique.");
                        }
                    } else if (maintenant - dernierProbleme > 120000L) {
                        sondesDegradees = 0;
                    }
                    prochain = maintenant + 5000;
                    continue;
                }
                long rxApres = TrafficStats.getUidRxBytes(uid);
                if (rxAvant >= 0 && rxApres - rxAvant > 20000) {
                    echecs = 0;
                    dernierOk = maintenant;
                    sondesDegradees++;
                    dernierProbleme = maintenant;
                    if (sondesDegradees >= 3) {
                        reconnexionRapide = true;
                        throw new ErreurVpn("Le tunnel est dégradé (" + sondesDegradees
                                + " tests sans réponse malgré le trafic). Relance automatique.");
                    }
                    if (!congestionSignalee) {
                        congestionSignalee = true;
                        Journal.info("Test lent mais le trafic circule : connexion conservée.");
                    }
                    prochain = maintenant + 8000;
                    continue;
                }
                echecs++;
                if (echecs >= SEUIL_ECHECS && maintenant - dernierOk >= DELAI_MIN_ECHEC_MS) {
                    throw new ErreurVpn("Le tunnel ne répond plus (" + echecs
                            + " tests consécutifs sans réponse). Relance automatique.");
                }
                Journal.erreur("Tunnel sans réponse (" + echecs + "/" + SEUIL_ECHECS
                        + ") : nouveau test dans quelques secondes.");
                prochain = maintenant + 4000;
            }
        } finally {
            arreterSurveillanceReseau();
        }
    }


    // ------------------------------------------------------------------
    // Certificat TLS : epinglage automatique quand le nom ne correspond pas
    // ------------------------------------------------------------------

    private GenerateurXray.Resultat epinglageAuto(Configuration c, String adresse,
                                                  GenerateurXray.Resultat r) throws ErreurVpn {
        try {
            org.json.JSONObject ss = new org.json.JSONObject(r.json)
                    .getJSONArray("outbounds").getJSONObject(0)
                    .getJSONObject("streamSettings");
            if (!"tls".equals(ss.optString("security"))) {
                return r;
            }
            org.json.JSONObject tls = ss.optJSONObject("tlsSettings");
            if (tls == null || tls.has("pinnedPeerCertSha256")) {
                return r;
            }
            String nom = tls.optString("serverName", "");
            if (nom.isEmpty()) {
                nom = c.serveur;
            }
            if (certificatConforme(adresse, c.port, nom)) {
                return r;
            }
            String empreinte = lireEmpreinteServeur(adresse, c.port, nom);
            if (empreinte == null) {
                return r;
            }
            Journal.avertissement("Le certificat du serveur ne correspond pas au nom TLS « "
                    + nom + " ». Empreinte enregistrée pour cette configuration (SHA-256 : "
                    + empreinte.substring(0, 16) + "…). Tout autre certificat sera refusé.");
            c.pinCert = empreinte;
            new ConfigStore(this).remplacer(c);
            try {
                return GenerateurXray.generer(c, adresse);
            } catch (ErreurImport e) {
                throw new ErreurVpn(e.getMessage());
            }
        } catch (org.json.JSONException e) {
            return r;
        }
    }

    // true si la poignee de main TLS normale reussit, ou si le reseau empeche de conclure
    private boolean certificatConforme(String adresse, int port, String nom) {
        try (Socket brut = new Socket()) {
            brut.connect(new InetSocketAddress(adresse, port), 4000);
            brut.setSoTimeout(4000);
            javax.net.ssl.SSLSocket ss = (javax.net.ssl.SSLSocket)
                    ((javax.net.ssl.SSLSocketFactory) javax.net.ssl.SSLSocketFactory.getDefault())
                            .createSocket(brut, nom, port, true);
            javax.net.ssl.SSLParameters pr = ss.getSSLParameters();
            pr.setEndpointIdentificationAlgorithm("HTTPS");
            try {
                pr.setServerNames(java.util.Collections.singletonList(
                        new javax.net.ssl.SNIHostName(nom)));
            } catch (IllegalArgumentException ignore) {
                // nom non valide comme nom d'hote (adresse IP) : pas de SNI
            }
            ss.setSSLParameters(pr);
            ss.startHandshake();
            return true;
        } catch (IOException e) {
            for (Throwable t = e; t != null; t = t.getCause()) {
                if (t instanceof java.security.cert.CertificateException) {
                    return false;
                }
            }
            return true;
        } catch (RuntimeException e) {
            return true;
        }
    }

    private String lireEmpreinteServeur(String adresse, int port, String nom) {
        try {
            javax.net.ssl.SSLContext sc = javax.net.ssl.SSLContext.getInstance("TLS");
            sc.init(null, new javax.net.ssl.TrustManager[]{new javax.net.ssl.X509TrustManager() {
                public void checkClientTrusted(java.security.cert.X509Certificate[] x, String a) { }
                public void checkServerTrusted(java.security.cert.X509Certificate[] x, String a) { }
                public java.security.cert.X509Certificate[] getAcceptedIssuers() {
                    return new java.security.cert.X509Certificate[0];
                }
            }}, null);
            try (Socket brut = new Socket()) {
                brut.connect(new InetSocketAddress(adresse, port), 4000);
                brut.setSoTimeout(4000);
                javax.net.ssl.SSLSocket ss = (javax.net.ssl.SSLSocket)
                        sc.getSocketFactory().createSocket(brut, nom, port, true);
                javax.net.ssl.SSLParameters pr = ss.getSSLParameters();
                try {
                    pr.setServerNames(java.util.Collections.singletonList(
                            new javax.net.ssl.SNIHostName(nom)));
                } catch (IllegalArgumentException ignore) {
                    // pas de SNI
                }
                ss.setSSLParameters(pr);
                ss.startHandshake();
                byte[] d = java.security.MessageDigest.getInstance("SHA-256").digest(
                        ss.getSession().getPeerCertificates()[0].getEncoded());
                StringBuilder sb = new StringBuilder();
                for (byte b : d) {
                    sb.append(String.format(java.util.Locale.ROOT, "%02x", b));
                }
                return sb.toString();
            }
        } catch (Exception e) {
            Journal.avertissement("Lecture du certificat impossible : " + e.getMessage());
            return null;
        }
    }

    private long joindre(String adresse, int port) {
        long debut = SystemClock.elapsedRealtime();
        try (Socket s = new Socket()) {
            s.connect(new InetSocketAddress(adresse, port), 3000);
            return SystemClock.elapsedRealtime() - debut;
        } catch (IOException e) {
            return -1;
        }
    }

    private void verifierArret() throws InterruptedException {
        if (arret) {
            throw new InterruptedException("arrêt demandé");
        }
    }

    private void envoyerTun() throws ErreurVpn, IOException {
        final LocalServerSocket s = serveur;
        final ParcelFileDescriptor t = tun;
        if (s == null || t == null) {
            throw new ErreurVpn("Connexion annulée.");
        }
        Thread garde = new Thread(() -> {
            try {
                Thread.sleep(10000);
            } catch (InterruptedException e) {
                return;
            }
            try {
                s.close();
            } catch (IOException ignore) {
                // fermeture de la socket : rien à faire
            }
        }, "yiwalo-garde");
        garde.setDaemon(true);
        garde.start();

        LocalSocket client;
        try {
            client = s.accept();
        } catch (IOException e) {
            if (arret) {
                throw new ErreurVpn("Connexion annulée.");
            }
            throw new ErreurVpn("Le moteur n'a pas reçu l'interface VPN dans le délai prévu. "
                    + "Consultez les journaux.");
        } finally {
            garde.interrupt();
        }
        try {
            client.setFileDescriptorsForSend(new FileDescriptor[]{t.getFileDescriptor()});
            OutputStream sortie = client.getOutputStream();
            sortie.write(0);
            sortie.flush();
        } finally {
            client.close();
        }
    }

    // ------------------------------------------------------------------
    // Test réel du tunnel (SOCKS5 local authentifié -> serveur -> internet)
    // ------------------------------------------------------------------

    private long tester(GenerateurXray.Resultat r) {
        return tester(r, SONDES[0]);
    }

    private long tester(GenerateurXray.Resultat r, String hote) {
        return tester(r, hote, 20000);
    }

    private long tester(GenerateurXray.Resultat r, String hote, int delaiLectureMs) {
        portTest = r.portTest;
        utilisateurTest = r.utilisateurTest;
        motDePasseTest = r.motDePasseTest;
        long debut = SystemClock.elapsedRealtime();
        final String[] etape = {"connexion locale au moteur"};
        try (Socket s = new Socket()) {
            s.connect(new InetSocketAddress("127.0.0.1", r.portTest), 3000);
            s.setSoTimeout(delaiLectureMs);
            OutputStream out = s.getOutputStream();
            InputStream in = s.getInputStream();

            etape[0] = "échange avec le moteur";
            out.write(new byte[]{5, 1, 2});
            out.flush();
            byte[] rep = lire(in, 2);
            if (rep[0] != 5 || rep[1] != 2) {
                Journal.avertissement("Test du tunnel : négociation SOCKS refusée.");
                return -1;
            }

            byte[] u = r.utilisateurTest.getBytes(StandardCharsets.UTF_8);
            byte[] mdp = r.motDePasseTest.getBytes(StandardCharsets.UTF_8);
            ByteArrayOutputStream auth = new ByteArrayOutputStream();
            auth.write(1);
            auth.write(u.length);
            auth.write(u);
            auth.write(mdp.length);
            auth.write(mdp);
            out.write(auth.toByteArray());
            out.flush();
            rep = lire(in, 2);
            if (rep[1] != 0) {
                Journal.avertissement("Test du tunnel : authentification SOCKS refusée.");
                return -1;
            }

            etape[0] = "connexion au serveur distant";
            byte[] h = hote.getBytes(StandardCharsets.US_ASCII);
            ByteArrayOutputStream conn = new ByteArrayOutputStream();
            conn.write(new byte[]{5, 1, 0, 3});
            conn.write(h.length);
            conn.write(h);
            conn.write(0);
            conn.write(80);
            out.write(conn.toByteArray());
            out.flush();
            rep = lire(in, 4);
            if (rep[1] != 0) {
                Journal.avertissement("Test du tunnel : connexion au serveur refusée (code SOCKS "
                        + rep[1] + ").");
                return -1;
            }
            int type = rep[3];
            int reste = type == 1 ? 4 : type == 4 ? 16 : in.read();
            lire(in, reste + 2);

            out.write(("GET /generate_204 HTTP/1.1\r\nHost: " + hote
                    + "\r\nConnection: keep-alive\r\n\r\n").getBytes(StandardCharsets.US_ASCII));
            out.flush();

            etape[0] = "attente de la réponse du serveur";
            StringBuilder ligne = new StringBuilder();
            int octet;
            while (ligne.length() < 100 && (octet = in.read()) >= 0 && octet != '\n') {
                ligne.append((char) octet);
            }
            String reponse = ligne.toString().trim();
            if (reponse.startsWith("HTTP/") && reponse.contains(" 204")) {
                long total = SystemClock.elapsedRealtime() - debut;
                try {
                    String lh;
                    int garde = 0;
                    do {
                        StringBuilder sb = new StringBuilder();
                        int c1;
                        while (sb.length() < 200 && (c1 = in.read()) >= 0 && c1 != '\n') {
                            sb.append((char) c1);
                        }
                        lh = sb.toString().trim();
                    } while (!lh.isEmpty() && ++garde < 30);
                    long t2 = SystemClock.elapsedRealtime();
                    out.write(("GET /generate_204 HTTP/1.1\r\nHost: " + hote
                            + "\r\nConnection: close\r\n\r\n").getBytes(StandardCharsets.US_ASCII));
                    out.flush();
                    StringBuilder l2 = new StringBuilder();
                    int c2;
                    while (l2.length() < 100 && (c2 = in.read()) >= 0 && c2 != '\n') {
                        l2.append((char) c2);
                    }
                    if (l2.toString().contains(" 204")) {
                        return SystemClock.elapsedRealtime() - t2;
                    }
                } catch (IOException ignore) {
                }
                return total;
            }
            Journal.avertissement("Test du tunnel : réponse inattendue « " + reponse + " ».");
            return -1;
        } catch (IOException e) {
            if (false) Journal.avertissement("Test du tunnel : " + e.getMessage()
                    + " (étape : " + etape[0] + ")");
            return -1;
        }
    }

    private static byte[] lire(InputStream in, int n) throws IOException {
        byte[] b = new byte[n];
        int lu = 0;
        while (lu < n) {
            int k = in.read(b, lu, n - lu);
            if (k < 0) {
                throw new IOException("Connexion fermée par le moteur");
            }
            lu += k;
        }
        return b;
    }

    // ------------------------------------------------------------------
    // Outils
    // ------------------------------------------------------------------

    private String resoudre(String hote) throws ErreurVpn {
        if (IPV4.matcher(hote).matches() || hote.contains(":")) {
            return hote;
        }
        try {
            InetAddress[] toutes = InetAddress.getAllByName(hote);
            InetAddress choix = toutes[0];
            for (InetAddress a : toutes) {
                if (a instanceof Inet4Address) {
                    choix = a;
                    break;
                }
            }
            Journal.info("Adresse du serveur résolue : " + choix.getHostAddress());
            CACHE_IP.put(hote, choix.getHostAddress());
            return choix.getHostAddress();
        } catch (UnknownHostException e) {
            String ancienne = CACHE_IP.get(hote);
            if (ancienne != null) {
                Journal.avertissement("Résolution impossible : dernière adresse connue utilisée.");
                return ancienne;
            }
            throw new ErreurVpn("Impossible de résoudre le nom du serveur « " + hote
                    + " ». Vérifiez votre connexion internet.");
        }
    }

    private int executer(List<String> commande, int secondes)
            throws IOException, InterruptedException, ErreurVpn {
        ProcessBuilder pb = new ProcessBuilder(commande);
        pb.environment().put("XRAY_LOCATION_ASSET", getFilesDir().getPath());
        pb.redirectErrorStream(true);
        Process p = pb.start();
        lireSortie(p);
        if (!p.waitFor(secondes, TimeUnit.SECONDS)) {
            p.destroyForcibly();
            throw new ErreurVpn("Le contrôle de la configuration a dépassé le délai.");
        }
        Thread.sleep(300);
        return p.exitValue();
    }

    private void lireSortie(Process p) {
        Thread t = new Thread(() -> {
            try (BufferedReader lecteur = new BufferedReader(
                    new InputStreamReader(p.getInputStream(), StandardCharsets.UTF_8))) {
                String ligne;
                String dernier = "";
                while ((ligne = lecteur.readLine()) != null) {
                    String conseil = conseilPour(ligne);
                    if (conseil != null && indice.isEmpty()) {
                        indice = conseil;
                    }
                    boolean connecte = SuiviVpn.etat() == EtatVpn.CONNECTE;
                    boolean erreurMoteur = ligne.contains("[Error]");
                    boolean avertissement = ligne.contains("[Warning]")
                            && !ligne.contains("deprecated") && !ligne.contains("started");
                    boolean echec = ligne.contains("failed to") || ligne.contains("REALITY")
                            || ligne.contains("connection ends");
                    if (!(erreurMoteur || avertissement || echec)) {
                        continue;
                    }
                    String corps = ligne.replaceFirst("^\\S+ \\S+ ", "")
                            .replaceFirst("\\[\\d+\\] ", "");
                    if (corps.equals(dernier)) {
                        continue;
                    }
                    dernier = corps;
                    if (erreurMoteur) {
                        if (!ligne.contains("connection was refused")) { Journal.erreur("[moteur] " + ligne); }
                    } else if (connecte && nbAvertissementsMoteur < 40) {
                        nbAvertissementsMoteur++;
                        Journal.avertissement("[moteur] " + corps);
                    } else {
                        garderDiagnostic(corps);
                    }
                }
            } catch (IOException ignore) {
                // flux fermé à l'arrêt du moteur
            }
        }, "yiwalo-sortie");
        t.setDaemon(true);
        t.start();
    }

    private void ecrire(File fichier, String contenu) throws IOException {
        try (FileOutputStream sortie = new FileOutputStream(fichier)) {
            sortie.write(contenu.getBytes(StandardCharsets.UTF_8));
        }
        fichier.setReadable(false, false);
        fichier.setReadable(true, true);
        fichier.setWritable(false, false);
        fichier.setWritable(true, true);
    }

    private volatile Process procDnstt, procSsh;
    public static volatile int portTest = 0;
    public static volatile String utilisateurTest = "", motDePasseTest = "";
    public static volatile int portDnstt = 7000, portSocksSlow = 1080;

    private static int portLibreSlow() {
        try (java.net.ServerSocket s = new java.net.ServerSocket(0, 1,
                java.net.InetAddress.getByName("127.0.0.1"))) {
            return s.getLocalPort();
        } catch (java.io.IOException e) {
            return 0;
        }
    }

    private void lireSortieSlow(final Process p, final String nom) {
        Thread t = new Thread(() -> {
            try (java.io.BufferedReader r = new java.io.BufferedReader(
                    new java.io.InputStreamReader(p.getInputStream(),
                            java.nio.charset.StandardCharsets.UTF_8))) {
                String l;
                while ((l = r.readLine()) != null) {
                    Journal.info("[" + nom + "] " + l);
                }
            } catch (java.io.IOException ignore) {
                // flux ferme
            }
        }, "yiwalo-" + nom);
        t.setDaemon(true);
        t.start();
    }

    private static void arreterProcessus(Process p) {
        if (p == null) {
            return;
        }
        p.destroy();
        try {
            if (!p.waitFor(2, java.util.concurrent.TimeUnit.SECONDS)) {
                p.destroyForcibly();
            }
        } catch (InterruptedException e) {
            p.destroyForcibly();
            Thread.currentThread().interrupt();
        }
    }

    private void demarrerSlowDns(Configuration c) throws ErreurVpn, InterruptedException {
        String dossier = getApplicationInfo().nativeLibraryDir;
        java.io.File dnstt = new java.io.File(dossier, "libdnstt.so");
        java.io.File ssh = new java.io.File(dossier, "libyiwalossh.so");
        if (!dnstt.exists() || !ssh.exists()) {
            throw new ErreurVpn("Les moteurs Slow DNS sont absents de l'application.");
        }
        String ns = c.slowNs == null ? "" : c.slowNs.trim();
        String cle = c.slowCle == null ? "" : c.slowCle.replaceAll("\\s", "");
        String res = c.slowResolveur == null ? "" : c.slowResolveur.trim();
        String user = c.sshUser == null ? "" : c.sshUser.trim();
        if (ns.isEmpty()) {
            throw new ErreurVpn("Le domaine NS est manquant.");
        }
        if (!cle.matches("[0-9a-fA-F]{64}")) {
            throw new ErreurVpn("La clé publique doit contenir 64 caractères hexadécimaux.");
        }
        if (user.isEmpty()) {
            throw new ErreurVpn("L'utilisateur SSH est manquant.");
        }
        if (res.isEmpty()) {
            res = "8.8.8.8:53";
        }
        if (res.indexOf(':') < 0) {
            res = res + ":53";
        }
        portDnstt = portLibreSlow();
        portSocksSlow = portLibreSlow();
        if (portDnstt == 0 || portSocksSlow == 0 || portDnstt == portSocksSlow) {
            throw new ErreurVpn("Aucun port local disponible pour Slow DNS.");
        }
        etat(EtatVpn.CONNEXION, "Démarrage de Slow DNS");
        try {
            ProcessBuilder pd = new ProcessBuilder(java.util.Arrays.asList(
                    dnstt.getPath(), "-udp", res, "-pubkey", cle, ns, "127.0.0.1:" + portDnstt));
            pd.directory(getFilesDir());
            pd.redirectErrorStream(true);
            Process p1 = pd.start();
            procDnstt = p1;
            lireSortieSlow(p1, "dnstt");
            Thread.sleep(1500);
            verifierArret();
            if (!p1.isAlive()) {
                throw new ErreurVpn("DNSTT s'est arrêté (code " + p1.exitValue()
                        + "). Consultez les journaux [dnstt] pour la cause.");
            }
            Journal.info("DNSTT lancé (résolveur " + res + ").");

            ProcessBuilder ps = new ProcessBuilder(java.util.Arrays.asList(
                    ssh.getPath(), "-connect", "127.0.0.1:" + portDnstt,
                    "-listen", "127.0.0.1:" + portSocksSlow, "-user", user));
            ps.directory(getFilesDir());
            ps.environment().put("YIWALO_SSH_PASS", c.sshMdp == null ? "" : c.sshMdp);
            ps.redirectErrorStream(true);
            Process p2 = ps.start();
            procSsh = p2;
            lireSortieSlow(p2, "ssh");
            Thread.sleep(2500);
            verifierArret();
            if (!p2.isAlive()) {
                throw new ErreurVpn("Le client SSH s'est arrêté (code " + p2.exitValue()
                        + "). Vérifiez l'utilisateur, le mot de passe et le serveur.");
            }
            Journal.info("SSH lancé, SOCKS local sur 127.0.0.1:" + portSocksSlow + ".");
        } catch (java.io.IOException e) {
            throw new ErreurVpn("Impossible de lancer Slow DNS : " + e.getMessage());
        }
    }

    private void demarrerSsh(Configuration c) throws ErreurVpn, InterruptedException {
        String dossier = getApplicationInfo().nativeLibraryDir;
        java.io.File ssh = new java.io.File(dossier, "libyiwalossh.so");
        if (!ssh.exists()) {
            throw new ErreurVpn("Le moteur SSH est absent de l'application.");
        }
        String user = c.sshUser == null ? "" : c.sshUser.trim();
        if (user.isEmpty()) {
            throw new ErreurVpn("L'utilisateur SSH est manquant.");
        }
        portSocksSlow = portLibreSlow();
        if (portSocksSlow == 0) {
            throw new ErreurVpn("Aucun port local disponible pour SSH.");
        }
        String adresseSsh = resoudre(c.serveur);
        etat(EtatVpn.CONNEXION, "Démarrage de SSH");
        try {
            ProcessBuilder ps = new ProcessBuilder(java.util.Arrays.asList(
                    ssh.getPath(), "-connect", adresseSsh + ":" + c.port,
                    "-listen", "127.0.0.1:" + portSocksSlow, "-user", user));
            ps.directory(getFilesDir());
            ps.environment().put("YIWALO_SSH_PASS", c.sshMdp == null ? "" : c.sshMdp);
            ps.redirectErrorStream(true);
            Process p2 = ps.start();
            procSsh = p2;
            lireSortieSlow(p2, "ssh");
            Thread.sleep(2500);
            verifierArret();
            if (!p2.isAlive()) {
                throw new ErreurVpn("Le client SSH s'est arrêté (code " + p2.exitValue()
                        + "). Vérifiez l'utilisateur, le mot de passe et le serveur.");
            }
            Journal.info("SSH lancé, SOCKS local sur 127.0.0.1:" + portSocksSlow + ".");
        } catch (java.io.IOException e) {
            throw new ErreurVpn("Impossible de lancer SSH : " + e.getMessage());
        }
    }

    private void nettoyer() {
        nettoyer(false);
    }

    /** garderTun : relance du moteur seule, l'interface VPN reste ouverte pour les applications. */
    private void nettoyer(boolean garderTun) {
        synchronized (verrou) {
            try {
                if (serveur != null) {
                    serveur.close();
                }
            } catch (IOException ignore) {
                // déjà fermée
            }
            try {
                if (ecoute != null) {
                    ecoute.close();
                }
            } catch (IOException ignore) {
                // déjà fermée
            }
            serveur = null;
            ecoute = null;
            if (fichierSocket != null) {
                fichierSocket.delete();
            }
            arreterProcessus(procSsh);
        procSsh = null;
        arreterProcessus(procDnstt);
        procDnstt = null;
        Process p = processus;
            processus = null;
            if (p != null) {
                p.destroy();
                try {
                    if (!p.waitFor(2, TimeUnit.SECONDS)) {
                        p.destroyForcibly();
                    }
                } catch (InterruptedException e) {
                    p.destroyForcibly();
                    Thread.currentThread().interrupt();
                }
            }
            if (tun != null && !garderTun) {
                try {
                    tun.close();
                } catch (IOException ignore) {
                    // déjà fermé
                }
                tun = null;
            }
            if (fichierConfig != null) {
                fichierConfig.delete();
            }
        }
    }

    private void etat(EtatVpn e, String message) {
        SuiviVpn.changer(e, message);
        Journal.info("État : " + e.name() + (message.isEmpty() ? "" : " — " + message));
    }

    @SuppressWarnings("deprecation")
    private Notification notification(int texte, boolean avecBouton) {
        PendingIntent ouvrir = PendingIntent.getActivity(
                this, 0, new Intent(this, MainActivity.class), PendingIntent.FLAG_IMMUTABLE);
        Notification.Builder b = new Notification.Builder(this, CANAL)
                .setSmallIcon(R.drawable.ic_power)
                .setContentTitle(getString(R.string.app_name))
                .setContentText(getString(texte))
                .setContentIntent(ouvrir)
                .setOngoing(true);
        if (avecBouton) {
            Intent d = new Intent(this, YiwaloVpnService.class).setAction(ACTION_DECONNECTER);
            PendingIntent pd = PendingIntent.getService(this, 1, d, PendingIntent.FLAG_IMMUTABLE);
            b.addAction(R.drawable.ic_power, getString(R.string.notif_bouton_deconnecter), pd);
        }
        return b.build();
    }

    private void notifierInfo(int titre, String detail) {
        Notification.Builder b = new Notification.Builder(this, CANAL)
                .setSmallIcon(R.drawable.ic_power)
                .setContentTitle(getString(titre))
                .setAutoCancel(true)
                .setTimeoutAfter(10000);
        if (!detail.isEmpty()) {
            b.setContentText(detail);
            b.setStyle(new Notification.BigTextStyle().bigText(detail));
        }
        getSystemService(NotificationManager.class).notify(ID_INFO, b.build());
    }
}
