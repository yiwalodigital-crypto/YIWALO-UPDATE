    private TextView outil(Context ctx, String texte, final Runnable r) {
        TextView v = ligne(ctx, texte);
        v.setTextSize(16f);
        v.setPadding(0, dp(12), 0, dp(12));
        v.setOnClickListener(x -> r.run());
        return v;
