        a.setTextColor(ctx.getColor(R.color.texte_discret));
        TextView b = new TextView(ctx);
        b.setText(valeur);
        b.setTextSize(15f);
        b.setTextColor(ctx.getColor(R.color.texte));
        b.setGravity(android.view.Gravity.END);
        l.addView(a, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
        l.addView(b, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
        parent.addView(l);
        return b;
    }

    // Xray : lu en lancant le moteur ("libxray.so version").
    // SSH : numero du module Go x/crypto lu dans le binaire s'il est present ; sinon protocole seul.
    private void lireVersions(final Context ctx, final TextView vx, final TextView vs) {
        final String dossier = ctx.getApplicationInfo().nativeLibraryDir;
        new Thread(() -> {
            String xray = "indisponible";
            try {
                Process p = new ProcessBuilder(dossier + "/libxray.so", "version")
                        .redirectErrorStream(true).start();
                if (!p.waitFor(3, java.util.concurrent.TimeUnit.SECONDS)) {
                    p.destroyForcibly();
                }
                java.io.BufferedReader r = new java.io.BufferedReader(new java.io.InputStreamReader(
                        p.getInputStream(), java.nio.charset.StandardCharsets.UTF_8));
                String l = r.readLine();
                if (l != null) {
                    java.util.regex.Matcher m = java.util.regex.Pattern
                            .compile("Xray\\s+([0-9][0-9A-Za-z.\\-]*)").matcher(l);
                    if (m.find()) {
                        xray = m.group(1);
                    }
                }
            } catch (Exception ignore) {
                // version indisponible
            }
            String ssh = "SSH-2.0";
            try {
                byte[] b = java.nio.file.Files.readAllBytes(
                        new java.io.File(dossier, "libyiwalossh.so").toPath());
                String t = new String(b, java.nio.charset.StandardCharsets.ISO_8859_1);
                java.util.regex.Matcher m = java.util.regex.Pattern
                        .compile("golang\\.org/x/crypto\\s+(v[0-9][0-9A-Za-z.\\-+]*)").matcher(t);
                if (m.find()) {
                    ssh = "SSH-2.0  ·  x/crypto " + m.group(1);
                } else {
                    ssh = "SSH-2.0  ·  client intégré";
                }
            } catch (Exception ignore) {
                // module absent
            }
            final String xf = xray;
            final String sf = ssh;
            vx.post(() -> {
                vx.setText(xf);
                vs.setText(sf);
            });
        }, "yiwalo-versions").start();
    }

    private int dp(int v) {
        return Math.round(v * getResources().getDisplayMetrics().density);
    }

