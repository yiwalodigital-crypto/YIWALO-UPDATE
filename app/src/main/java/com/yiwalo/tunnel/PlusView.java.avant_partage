    private TextView rangee(Context ctx, LinearLayout parent, String libelle, String valeur) {
        LinearLayout l = new LinearLayout(ctx);
        l.setOrientation(LinearLayout.HORIZONTAL);
        l.setPadding(0, dp(6), 0, dp(6));
        TextView a = new TextView(ctx);
