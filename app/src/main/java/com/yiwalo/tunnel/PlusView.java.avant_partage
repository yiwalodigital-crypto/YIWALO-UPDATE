    private void ouvrirReglage(Context ctx, Intent i) {
        try {
            ctx.startActivity(i);
        } catch (RuntimeException e) {
            Toast.makeText(ctx, "Indisponible sur ce téléphone", Toast.LENGTH_SHORT).show();
        }
    }

    private void viderDossier(java.io.File f, boolean racineDossier) {
        if (f == null) return;
        java.io.File[] fs = f.listFiles();
        if (fs != null) for (java.io.File c : fs) viderDossier(c, false);
        if (!racineDossier) f.delete();
    }

    private TextView testVitesse(final Context ctx) {
        final TextView v = ligne(ctx, "⚡  Test de vitesse");
        v.setTextSize(16f);
        v.setPadding(0, dp(12), 0, dp(12));
        final boolean[] enCours = {false};
        v.setOnClickListener(x -> {
            if (enCours[0]) return;
            enCours[0] = true;
            v.setText("⚡  Test en cours…");
            new Thread(() -> {
                String res;
                try {
                    java.net.URL u = new java.net.URL("https://speed.cloudflare.com/__down?bytes=10000000");
                    long t0 = System.nanoTime();
                    java.net.HttpURLConnection c = (java.net.HttpURLConnection) u.openConnection();
                    c.setConnectTimeout(8000);
                    c.setReadTimeout(8000);
                    c.connect();
                    if (c.getResponseCode() != 200) throw new java.io.IOException("http");
                    long lat = (System.nanoTime() - t0) / 1000000L;
                    java.io.InputStream in = c.getInputStream();
                    byte[] b = new byte[16384];
                    long total = 0;
                    long t1 = System.nanoTime();
                    int n;
                    while ((n = in.read(b)) > 0) {
                        total += n;
                        if (System.nanoTime() - t1 > 10000000000L) break;
                    }
                    in.close();
                    c.disconnect();
                    double sec = (System.nanoTime() - t1) / 1e9;
                    double mbps = total * 8 / 1e6 / sec;
                    res = String.format(java.util.Locale.US,
                        "⚡  Débit : %.1f Mb/s  ·  Latence : %d ms", mbps, lat);
                } catch (Exception e) {
                    res = "⚡  Échec du test (réseau indisponible)";
                }
                final String r = res;
                v.post(() -> {
                    v.setText(r);
                    enCours[0] = false;
                });
            }, "yiwalo-speed").start();
        });
        return v;
    }
