    static String t(String s) {
        if (!en || s == null) return s;
        String r = M.get(s);
        return r == null ? s : r;
    }

    static void traduire(View v) {
        if (v instanceof TextView) {
            TextView tv = (TextView) v;
            if (!(v instanceof EditText)) {
                CharSequence c = tv.getText();
                if (c != null && c.length() > 0 && c.length() < 200) {
                    String s = c.toString();
                    String r = t(s);
                    if (!r.equals(s)) tv.setText(r);
                }
            }
            CharSequence h = tv.getHint();
            if (h != null && h.length() > 0) {
                String s = h.toString();
                String r = t(s);
                if (!r.equals(s)) tv.setHint(r);
            }
        }
        if (v instanceof ViewGroup) {
            ViewGroup g = (ViewGroup) v;
            for (int i = 0; i < g.getChildCount(); i++) traduire(g.getChildAt(i));
        }
    }

    static void demarrer(final View racine) {
        if (!en || racine == null) return;
        final Handler h = new Handler(Looper.getMainLooper());
        h.post(new Runnable() {
            @Override public void run() {
                if (!racine.isAttachedToWindow()) return;
                traduire(racine);
                h.postDelayed(this, 400);
            }
        });
    }
}
