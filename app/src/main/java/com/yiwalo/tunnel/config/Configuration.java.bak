package com.yiwalo.tunnel.config;

import org.json.JSONException;
import org.json.JSONObject;

public final class Configuration {
    public final String id;
    public final String nom;
    public final TypeConnexion type;
    public final String serveur;
    public final int port;
    public final String lienOriginal;
    public final String sniManuel;

    public Configuration(String id, String nom, TypeConnexion type,
                         String serveur, int port, String lienOriginal) {
        this(id, nom, type, serveur, port, lienOriginal, "");
    }

    public Configuration(String id, String nom, TypeConnexion type,
                         String serveur, int port, String lienOriginal, String sniManuel) {
        this.sniManuel = sniManuel == null ? "" : sniManuel.trim();
        this.id = id;
        this.nom = nom;
        this.type = type;
        this.serveur = serveur;
        this.port = port;
        this.lienOriginal = lienOriginal;
    }

    public JSONObject versJson() throws JSONException {
        JSONObject o = new JSONObject();
        o.put("id", id);
        o.put("nom", nom);
        o.put("type", type.name());
        o.put("serveur", serveur);
        o.put("port", port);
        o.put("lien", lienOriginal);
        o.put("sni", sniManuel);
        return o;
    }

    public static Configuration depuisJson(JSONObject o) throws JSONException {
        return new Configuration(
                o.getString("id"),
                o.getString("nom"),
                TypeConnexion.valueOf(o.getString("type")),
                o.getString("serveur"),
                o.getInt("port"),
                o.getString("lien"),
                o.optString("sni", ""));
    }
}
